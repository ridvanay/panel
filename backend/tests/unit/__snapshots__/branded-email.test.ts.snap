exports[`sistem e-postaları — snapshot (TR/EN/AR) > code:security-2fa-reset · ar 1`] = `
{
  "html": "<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light" /><title>WM Health Istanbul</title></head>
