# QA — E2E ortamı (frontend/playwright.config.ts tarafından referans verilir). qa-agent
# tarafından yerel/CI Playwright koşumu için oluşturuldu. Prod'a hiç dokunmaz; ayrı saas_e2e
# veritabanı kullanır (backend/.env.example ile aynı şablon). İçindeki tüm değerler yalnızca
# yerel test sabitleridir — GERÇEK bir sır İÇERMEZ (ENCRYPTION_KEY dahi bu dosya için özel
# üretilmiş, rastgele bir test anahtarıdır).
#
# Kurulum (bkz. frontend/playwright.config.ts başlığı):
#   docker exec <postgres-container> psql -U postgres -c "CREATE DATABASE saas_e2e;"
#   cd backend && DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_e2e?schema=public npx prisma migrate deploy
#   cd backend && DOTENV_CONFIG_PATH=.env.e2e npx tsx src/server.ts
NODE_ENV=development
PORT=4001
# Host şeması `.claude/architect-scope-doctor-subdomain.md` §6.3/§6.4 kararınca
# `siteadi.localhost`'a taşındı (bkz. backend/.env.example'daki FRONTEND_URL yorumu).
FRONTEND_URL=http://siteadi.localhost:3100
# Hekim portalı (`/doctor/**`) subdomain izolasyonu — YENİ (bkz. backend/.env.example'daki
# DOCTOR_FRONTEND_URL yorumu). qa-agent'ın doctor-subdomain-isolation.spec.ts'inin CORS/oturum
# senaryolarını (§7.4) test edebilmesi için e2e'de KASITLI OLARAK aktif bırakıldı.
DOCTOR_FRONTEND_URL=http://doktor.siteadi.localhost:3100
PUBLIC_URL=http://siteadi.localhost:4001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_e2e?schema=public
TRUST_PROXY=false
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
STRIPE_SECRET_KEY=sk_test_e2e
STRIPE_WEBHOOK_SECRET=whsec_test_e2e
# qa-agent bulgusu: telehealth-consultation.spec.ts §11b (409 APPOINTMENT_NOT_JOINABLE) sahte
# LiveKit anahtarı olmadan koşamıyor çünkü backend önce 503 LIVEKIT_NOT_CONFIGURED döner. Bu
# değerler yerel JWT imzalama için kullanılır, gerçek bir LiveKit sunucusuna hiç bağlanılmaz
# (`backend/src/modules/telehealth/lib/livekit.ts::createMeetingToken()` `livekit-server-sdk`'nin
# `AccessToken` sınıfıyla imzayı tamamen yerel üretir — ağ üzerinden hiçbir LiveKit sunucusuna
# ÇIKILMAZ, bu yüzden bu sunucunun gerçekten AYAKTA olması GEREKMEZ).
#
# GÜNCELLEME (2026-09-15, devops-agent): değerler artık kök `docker-compose.yml`'deki YEREL
# `livekit` servisinin (`livekit/livekit-server:latest`, `--dev` modu) gerçek `--keys`
# argümanıyla BİREBİR eşleşiyor (`ws://siteadi.localhost:7880` / `devkey` /
# `secret_livekit_local_dev_key_32bytes`, backend/.env.example ve docker-compose.yml'deki
# `backend.environment` bloğu İLE AYNI üçlü) — e2e koşumu `docker compose up`daki `livekit`
# servisine karşı çalıştırılırsa (frontend `siteadi.localhost:3100` portundan `serverUrl`
# olarak dönen bu adrese gerçekten bağlanabilir hale gelir), aksi halde (yalnızca backend/.env.e2e
# ile `tsx src/server.ts` çalıştırılan, `livekit` servisi ayakta olmayan senaryoda) hâlâ yalnızca
# JWT imzalamak için kullanılır — her iki durumda da `LIVEKIT_NOT_CONFIGURED` 503'ü artık dönmez.
LIVEKIT_URL=ws://siteadi.localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_local_dev_key_32bytes
REVALIDATE_SECRET=e2e-revalidate-secret
RATE_LIMIT_MAX=3000
RATE_LIMIT_WINDOW=1 minute
# qa-agent bulgusu (security-agent onaylı, bkz. auth.routes.ts::AUTH_RATE_LIMIT yorumu): 28 spec
# dosyasının beforeAll'da yaptığı gerçek UI login'leri 17dk'lık sıralı koşuda bugünkü sabit 5/dk
# limitini aşıp 429 ile zincirleme test başarısızlığına yol açıyordu. Prod/dev'de tanımsız (=5).
AUTH_RATE_LIMIT_MAX=50
STORAGE_DRIVER=local
ENCRYPTION_KEY=oSOqrQ3w1FqlhmGtPPOxTO7txMTUC3pJc3trMMdVkts=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=No-Reply <no-reply@example.com>
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
CUSTOM_CODE_ENABLED=true
# qa-agent (2026-09-15, admin demo-ödeme toggle e2e'si için): NODE_ENV=development zaten yukarıda
# tanımlı, `ENABLE_DEMO_PAYMENTS`in fail-closed boot koruması (backend/src/config/env.ts) yalnızca
# NODE_ENV=production ile bu bayrağın birlikte true olmasını engeller — .env.e2e bundan hiç
# etkilenmez, GÜVENLİDİR. Demo ödeme toggle'ının "açık" mutlu yolunu (buton görünürlüğü + admin
# switch + PATCH /admin/settings) e2e'de test edebilmek için eklendi.
ENABLE_DEMO_PAYMENTS=true
