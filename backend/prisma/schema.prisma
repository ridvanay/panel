// docs/architecture/ARCHITECTURE.md (bölüm 6, ER diyagramı) ve openapi.yaml ile
// birebir uyumlu tutulmalıdır. Alan/enum değişikliği önce oradaki dokümanlara yansır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PageStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

// Sayfa düzenleyicide standart/gelişmiş mod ayrımı — bkz.
// .claude/architect-scope-page-editor-roles.md §2 (bağlayıcı karar dokümanı). Bu bir
// `CREATE TYPE`'dır, `ALTER TYPE ... ADD VALUE` DEĞİLDİR — SiteUserStatus/ImportJobType'taki
// geri-alınamazlık uyarısı BU migration için GEÇERLİ DEĞİLDİR. FREEFORM = serbest tasarım
// (bugünkü davranış, yapı değiştirmek serbest). TEMPLATE = yapı DONMUŞ; standart (gelişmiş
// yeteneği olmayan) kullanıcı yalnızca §3.2'deki sabit alan haritasındaki içerik alanlarını
// doldurabilir — uygulama backend-agent'ın `lib/page-template-guard.ts` diff'inde yapılır,
// burada değil.
enum PageEditMode {
  FREEFORM
  TEMPLATE
}

// `/admin/*` CMS uçları için org'dan bağımsız site-geneli rol/durum — MembershipRole ile
// KARIŞTIRILMAMALI, tamamen ayrı bir yetkilendirme ekseni (bkz. middleware/site-rbac.ts).
// 5 kademeli kurumsal RBAC (bkz. .claude/architect-scope-rbac-5-tier.md §1, bağlayıcı karar
// dokümanı) — eski enum ADMIN/EDITOR/VIEWER idi, VIEWER KALDIRILDI. Değer SIRASI bağlayıcıdır
// (ADMIN → USER, ayrıcalıktan azalan; PostgreSQL enum tanım sırası ORDER BY role davranışını
// belirler, bkz. §1). ADMIN = süper yönetici (sistem/ayarlar/kullanıcılar, serbest Page
// Builder). MANAGER = panelin tamamı, blok YAPISINI değiştiremez (§6). EDITOR = yalnızca
// blog + medya + sayfa İÇERİĞİ (§5.3). CUSTOMER = panel YOK, ödeme tamamlanınca USER'dan
// otomatik terfi edilir (§7.2). USER = varsayılan/standart üye, panel YOK (§7.1).
enum SiteRole {
  ADMIN
  MANAGER
  EDITOR
  CUSTOMER
  USER
}

// §10.7 benzeri soft-delete (çöp kutusu) deseni, kullanıcılar için — DELETED durumundaki
// kullanıcı giriş yapamaz, admin listelerinde varsayılan olarak gizlenir; `deletedAt` alanı
// (User modeli) ile birlikte "ne zaman silindi" bilgisini taşır. Enum değeri eklemek geri
// alınamaz bir işlemdir (ALTER TYPE ... ADD VALUE) — bu migration ImportJobType.PRODUCTS
// ile AYNI ilkeyle, izole/tek başına gönderilir (bkz. satır 90-92).
enum SiteUserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuditStatus {
  SUCCESS
  FAILURE
  FORBIDDEN
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
  UNKNOWN
}

// §10.1 İçerik Sürüm Kontrolü — ContentRevision.entityType (bkz. ARCHITECTURE.md §10.1).
// §10.5 Çoklu Dil & Yerelleştirme — ContentSlug.entityType de BU enum'ı kullanır (bkz.
// .claude/architect-scope-i18n.md §2.2, bağlayıcı karar dokümanı); yerelleştirme için
// ayrı bir "içerik tipi" enum'ı İCAT EDİLMEZ.
enum ContentEntityType {
  PAGE
  BLOG_POST
  PRODUCT
  PORTFOLIO_ITEM
}

// §10.8 Toplu İçe Aktarma (Import) — bkz. ARCHITECTURE.md §10.8.2.
enum ImportJobType {
  PAGES
  BLOG
  WORDPRESS
  USERS
  MEDIA
  // §10.8.9 WooCommerce ürün içe aktarma. Enum değeri eklemek geri alınamaz bir
  // işlemdir (ALTER TYPE ... ADD VALUE) — bu migration tek başına gönderilir.
  PRODUCTS
}

enum ImportSourceFormat {
  CSV
  JSON
  XML
  ZIP
}

enum ImportJobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportDuplicateStrategy {
  SKIP
  OVERWRITE
  CREATE_NEW
}

enum ImportErrorSeverity {
  ERROR
  SKIPPED
}

// §10.8.10 Analitik Rapor Dışa Aktarma (Export) — bkz. ARCHITECTURE.md §10.8.10.
// /admin/stats uçlarıyla uyumlu rapor türleri.
enum ExportJobType {
  VIEWS
  BREAKDOWN
  SUMMARY
  TOP_CONTENT
  USERS
  REVENUE
}

enum ExportFileFormat {
  CSV
  PDF
}

// ImportJobStatus'tan daha sade: QUEUED/CANCELLED yok — worker tek-instance
// senkron/kuyruksuz olacak (bkz. §10.8.1'deki "Kuyruk YOK" kararıyla aynı desen).
enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Değer sırası bağlayıcıdır (bkz. .claude/architect-scope-customer-portal.md §6, bağlayıcı
// karar dokümanı). `SHIPPED` PAID ile FULFILLED arasına eklendi — `DELIVERED` EKLENMEDİ:
// FULFILLED zaten terminal başarı durumudur, ikisini birlikte tutmak "hangisi bitmiş?"
// belirsizliği üretirdi. FULFILLED'ın görünen (TR) etiketi "Teslim Edildi" olarak
// yeniden adlandırıldı (tek sözlük: frontend/src/lib/order-status.ts) — enum DEĞERİ
// DEĞİŞMEDİ, yalnızca etiket. Bu değer kendi izole migration'ında eklendi (ALTER TYPE
// ... ADD VALUE PostgreSQL'de kendi transaction'ı dışında kullanılamaz) — bkz.
// migrations/*_add_order_status_shipped.
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  FULFILLED
}

// --- §10.13 Üçüncü Parti Entegrasyon: API Anahtarları (§10.13.3) ---

// İLERİYE DÖNÜK: public katman v1'de salt-okunurdur, ama scope kontrolü ŞİMDİDEN
// şemada ve doğrulama hattında vardır (bkz. §10.13.4) — yazma uçları eklendiğinde
// yeni bir migration ve yeni bir yetki ekseni İCAT EDİLMESİN diye.
enum ApiKeyScope {
  READ
  READ_WRITE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

// --- §10.13 Üçüncü Parti Entegrasyon: Giden Webhook'lar (§10.13.8) ---

// Wire (JSON) gösterimi ENUM ADIYLA BİREBİR AYNIDIR — SCREAMING_SNAKE. Ayrı bir
// `blog_post.published` gibi nokta-notasyonu eşleme tablosu BİLİNÇLİ olarak
// AÇILMADI: projedeki tüm enum'lar (`OrderStatus`, `PageStatus`, `ImportJobType`)
// wire'da SCREAMING_SNAKE'tir; ikinci bir gösterim kaçınılmaz olarak sapardı.
enum WebhookEvent {
  PING // yalnızca POST .../test ile üretilir, gerçek bir olay değildir
  PAGE_PUBLISHED
  BLOG_POST_PUBLISHED
  BLOG_POST_UPDATED
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
  PORTFOLIO_ITEM_PUBLISHED
  ORDER_CREATED
  ORDER_PAID
  ORDER_STATUS_CHANGED
}

enum OutboundWebhookStatus {
  ACTIVE
  PAUSED // admin elle duraklattı
  DISABLED // sistem üst üste başarısızlık sonrası otomatik kapattı (§10.13.8)
}

enum WebhookDeliveryStatus {
  PENDING // sıraya alındı, henüz denenmedi
  SENDING // şu an gönderiliyor (çökme kurtarması bu durumu arar)
  RETRYING // en az bir deneme başarısız, `nextAttemptAt` dolu
  SUCCEEDED // 2xx alındı
  FAILED // kalıcı hata VEYA deneme hakkı tükendi
}

model User {
  id              String         @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama için.
  seq             Int            @unique @default(autoincrement())
  email           String         @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  role            SiteRole       @default(USER)
  status          SiteUserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  // Soft-delete (çöp kutusu) — status=DELETED ile birlikte set edilir; sadece silindiyse
  // dolu. Kalıcı silme (hard delete) DEĞİL — DELETE /admin/users/{userId} bu alanı doldurur,
  // POST /admin/users/{userId}/restore null'a döndürür (bkz. openapi.yaml).
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // §10.4 Güvenlik & 2FA (TOTP) — bkz. ARCHITECTURE.md §10.4.
  twoFactorEnabled    Boolean   @default(false)
  // AES-256-GCM ile şifrelenmiş base32 TOTP secret — DÜZ METİN SAKLANMAZ (bkz. lib/crypto.ts).
  twoFactorSecret     String?
  twoFactorVerifiedAt DateTime?

  // NOT: `advancedBuilderEnabled` kolonu KALDIRILDI (bkz.
  // .claude/architect-scope-rbac-5-tier.md §3, bağlayıcı karar dokümanı — bu doküman
  // .claude/architect-scope-page-editor-roles.md §1'i revize eder). Gelişmiş Page Builder
  // yeteneği artık saf rol türevidir: `canUseAdvancedBuilder(user) = user.role === "ADMIN"`
  // (backend-agent'ın `lib/builder-capability.ts` yardımcısında türetilir, DB'de saklanmaz).
  // MANAGER ve EDITOR için bu değer HER ZAMAN false'tur — kullanıcı-başı bir "verilen izin"
  // kolonu artık gerekmiyor (ölü kolon riski, bkz. §3.2).

  ownedOrganizations     Organization[]       @relation("OrganizationOwner")
  memberships            Membership[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  blogPosts              BlogPost[]
  pages                  Page[]
  // §10.9.2 Ürünler Modülü — bkz. ARCHITECTURE.md §10.9.2.
  products               Product[]            @relation("ProductAuthor")
  // §10.9.4 Portföy Modülü — bkz. ARCHITECTURE.md §10.9.4.
  portfolioItems         PortfolioItem[]      @relation("PortfolioAuthor")
  auditLogs              AuditLog[]           @relation("AuditLogActor")
  backupCodes            BackupCode[]
  // Polymorphic ContentRevision.editedById / EmailTemplate.updatedById için zorunlu karşı-ilişki alanları.
  contentRevisions       ContentRevision[]    @relation("ContentRevisionEditor")
  emailTemplateEdits     EmailTemplate[]      @relation("EmailTemplateUpdater")
  // §10.8 Toplu İçe Aktarma (Import) — bkz. ARCHITECTURE.md §10.8.2.
  importJobs             ImportJob[]          @relation("ImportJobCreator")
  // §10.8.10 Analitik Rapor Dışa Aktarma (Export) — bkz. ARCHITECTURE.md §10.8.10.
  exportJobs             ExportJob[]          @relation("ExportJobCreator")
  // §10.9 Eklenti/Modül Yönetimi — bkz. ARCHITECTURE.md §10.9.
  siteModuleUpdates      SiteModule[]         @relation("SiteModuleUpdater")
  // §10.9.3 Sepet + Stripe Checkout — genelde NULL kalır (misafir checkout); SiteRole
  // kullanıcısı (ör. ADMIN test amaçlı) teorik olarak sepet/sipariş sahibi olabilir.
  carts                  Cart[]               @relation("CartOwner")
  orders                 Order[]              @relation("OrderCustomer")
  // Müşteri & E-Ticaret Alanı (Customer Portal) — bkz.
  // .claude/architect-scope-customer-portal.md §5.1/§5.2.
  addresses              Address[]            @relation("AddressOwner")
  wishlistItems          WishlistItem[]       @relation("WishlistOwner")
  // §10.12.6 Özel CSS/JS denetim izi — SiteCustomCode.cssUpdatedById/jsUpdatedById
  // için zorunlu karşı-ilişki alanları (ContentRevision/EmailTemplate ile AYNI desen).
  cssCodeUpdates         SiteCustomCode[]     @relation("SiteCustomCodeCssUpdater")
  jsCodeUpdates          SiteCustomCode[]     @relation("SiteCustomCodeJsUpdater")
  // §10.13 Üçüncü Parti Entegrasyon — API anahtarı + giden webhook denetim izi
  // için zorunlu karşı-ilişki alanları (ImportJob/ExportJob ile AYNI desen).
  apiKeysCreated         ApiKey[]             @relation("ApiKeyCreator")
  apiKeysRevoked         ApiKey[]             @relation("ApiKeyRevoker")
  outboundWebhooks       OutboundWebhook[]    @relation("OutboundWebhookCreator")
  // §10.16.7 İletişim formu — ContactForm.updatedById / ContactSubmission.readById
  // için zorunlu karşı-ilişki alanları (ContentRevision/EmailTemplate ile AYNI desen).
  contactFormUpdates     ContactForm[]        @relation("ContactFormUpdater")
  contactSubmissionsRead ContactSubmission[]  @relation("ContactSubmissionReader")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama için.
  seq       Int      @unique @default(autoincrement())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation("OrganizationOwner", fields: [ownerId], references: [id])
  memberships  Membership[]
  invitations  Invitation[]
  subscription Subscription?

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid())
  seq            Int              @unique @default(autoincrement())
  userId         String
  organizationId String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           MembershipRole
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Aynı e-posta için birden fazla PENDING davet olmasın kontrolü uygulama
  // katmanında yapılır (Prisma koşullu/kısmi unique index'i desteklemiyor).
  @@index([organizationId, email])
  @@map("invitations")
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  priceMonthlyCents    Int
  priceYearlyCents     Int
  currency             String   @default("TRY")
  limits               Json     @default("{}")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// Opak refresh token'ın SHA-256 hash'i saklanır, ham değer asla DB'ye yazılmaz.
model RefreshToken {
  id                  String   @id @default(uuid())
  userId              String
  tokenHash           String   @unique
  expiresAt           DateTime
  revoked             Boolean  @default(false)
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Tek site (global) kapsamında: organizationId yok, herhangi bir authenticated kullanıcı yönetir.
model Page {
  id              String       @id @default(uuid())
  seq             Int          @unique @default(autoincrement())
  title           String
  // §10.5 Çoklu Dil & Yerelleştirme — VARSAYILAN dilin (Locale.isDefault) kanonik
  // slug'ı. Diğer dillerin slug'ları BURADA DEĞİL, ContentSlug tablosundadır (bkz.
  // .claude/architect-scope-i18n.md §2.3, bağlayıcı karar dokümanı) — bu kolon
  // yapısal olarak DEĞİŞMEDİ, yalnızca anlamı netleştirildi.
  slug            String       @unique
  status          PageStatus   @default(DRAFT)
  // Sayfa builder blokları — sıralı JSON dizi, şekli frontend'de lib/page-builder/types.ts::Block ile eşleşir.
  blocks          Json         @default("[]")
  seoTitle        String?
  seoDescription  String?
  // §10.2 Gelişmiş SEO & Social Card — bkz. ARCHITECTURE.md §10.2.
  ogTitle         String?
  ogImageUrl      String?
  canonicalUrl    String?
  noIndex         Boolean      @default(false)
  // §10.5 Çoklu Dil & Yerelleştirme — varsayılan dil (Locale.isDefault) alanları TR
  // KOLONLARDA kanonik; diğer diller `{ [locale]: { title, ... } }` şeklinde küçük harf
  // BCP-47 anahtarlarla BURADA (ör. translations.en). Ayrı bir Translation tablosu
  // BİLİNÇLİ olarak AÇILMADI (gerekçe: .claude/architect-scope-i18n.md §1.2). Slug bu
  // JSON'da TUTULMAZ — bkz. ContentSlug modeli (§1.3).
  translations    Json         @default("{}")
  // §5 istisnası — hukuki belge (gizlilik politikası, KVKK aydınlatma metni, çerez
  // politikası, kullanım koşulları, mesafeli satış sözleşmesi...).
  // true ise SESSİZ ÇEVİRİ FALLBACK'İ UYGULANMAZ (KVKK m.10 / GDPR m.12) —
  // gerekçe ve tam davranış: .claude/architect-scope-i18n.md §5.1 (bkz. §2.3.1,
  // compliance-agent itirazı üzerine eklendi — alan adı DAVRANIŞ değil NİYET taşır).
  // YALNIZCA SiteRole=ADMIN değiştirebilir; her değişiklik denetlenir.
  isLegalDocument Boolean      @default(false)
  // Sayfa düzenleyicide standart/gelişmiş mod ayrımı — bkz.
  // .claude/architect-scope-page-editor-roles.md §2 (bağlayıcı karar dokümanı). Yalnızca
  // ADMIN veya gelişmiş yetenekli EDITOR değiştirebilir (§2.5); standart kullanıcı bu alanı
  // gönderirse 403. Varsayılan FREEFORM = bugünkü davranışla birebir aynı, backfill GEREKMEZ.
  editMode        PageEditMode @default(FREEFORM)
  publishedAt     DateTime?
  // Zamanlanmış yayın hedef tarihi — yalnızca status=SCHEDULED iken anlamlı; süreç-içi sweeper bu
  // tarihe ulaşınca status'u PUBLISHED'a çevirir (bkz. modules/{blog,pages}/*-publish-scheduler.ts).
  scheduledAt     DateTime?
  // Denormalize toplam sayaç — admin liste/detay ekranlarında ekstra sorgu gerektirmeden okunur.
  viewCount       Int          @default(0)
  // §10.7 Soft-delete (çöp kutusu) — bkz. ARCHITECTURE.md §10.7.
  deletedAt       DateTime?
  authorId        String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  author              User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  views               PageView[]
  siteSettings        SiteSettings[]
  // §10.16.7 İletişim formu — ContactForm.consentLegalPageId için zorunlu karşı-ilişki alanı.
  contactFormConsents ContactForm[]  @relation("ContactFormConsentPage")

  @@index([deletedAt, status])
  @@index([authorId])
  @@map("pages")
}

model BlogCategory {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id             String     @id @default(uuid())
  seq            Int        @unique @default(autoincrement())
  title          String
  // §10.5 Çoklu Dil & Yerelleştirme — VARSAYILAN dilin (Locale.isDefault) kanonik
  // slug'ı. Diğer dillerin slug'ları BURADA DEĞİL, ContentSlug tablosundadır (bkz.
  // .claude/architect-scope-i18n.md §2.3, bağlayıcı karar dokümanı) — bu kolon
  // yapısal olarak DEĞİŞMEDİ, yalnızca anlamı netleştirildi.
  slug           String     @unique
  excerpt        String?
  contentHtml    String     @default("")
  coverImageUrl  String?
  status         PageStatus @default(DRAFT)
  categoryId     String?
  authorId       String?
  seoTitle       String?
  seoDescription String?
  // §10.2 Gelişmiş SEO & Social Card — bkz. ARCHITECTURE.md §10.2.
  ogTitle        String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean    @default(false)
  // §10.5 Çoklu Dil & Yerelleştirme — varsayılan dil (Locale.isDefault) alanları TR
  // KOLONLARDA kanonik; diğer diller `{ [locale]: { title, ... } }` şeklinde küçük harf
  // BCP-47 anahtarlarla BURADA (ör. translations.en). Ayrı bir Translation tablosu
  // BİLİNÇLİ olarak AÇILMADI (gerekçe: .claude/architect-scope-i18n.md §1.2). Slug bu
  // JSON'da TUTULMAZ — bkz. ContentSlug modeli (§1.3).
  translations   Json       @default("{}")
  publishedAt    DateTime?
  // Zamanlanmış yayın hedef tarihi — yalnızca status=SCHEDULED iken anlamlı; süreç-içi sweeper bu
  // tarihe ulaşınca status'u PUBLISHED'a çevirir (bkz. modules/{blog,pages}/*-publish-scheduler.ts).
  scheduledAt    DateTime?
  viewCount      Int        @default(0)
  // §10.7 Soft-delete (çöp kutusu) — bkz. ARCHITECTURE.md §10.7.
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  views    PageView[]
  tags     BlogPostTag[]

  @@index([categoryId])
  @@index([deletedAt, status])
  @@index([authorId])
  @@map("blog_posts")
}

// §10.14 Blog Etiketleri (Tag) — çoka-çok sınıflandırma, bkz. ARCHITECTURE.md §10.14.1.
// `BlogCategory` ile AYNI basitlikte (id/seq/name/slug); kategoriden farkı çoka-çok olması
// (bkz. BlogPostTag ara tablosu). `name` üzerinde DB tekilliği YOK, kimlik `slug`'dır
// (§10.14.3) — "React" ve "react" aynı slug'a düşer, ikincisi 409 alır.
model BlogTag {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  posts BlogPostTag[]

  @@map("blog_tags")
}

// §10.14.1 — açık (explicit) ara tablo, Prisma implicit m-n BİLİNÇLİ OLARAK KULLANILMADI
// (implicit ilişki `_BlogPostToBlogTag` üretir, snake_case + @@map standardını ihlal eder).
// §10.14.2 silme semantiği: yazı çöpe giderse bu satırlar KORUNUR (soft-delete dokunmaz);
// yazı kalıcı silinirse ya da etiket silinirse cascade düşer (karşı taraf yaşamaya devam eder).
model BlogPostTag {
  postId String
  tagId  String

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

model ProductCategory {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  products Product[]

  @@map("product_categories")
}

// §10.9.2 Ürünler Modülü (Eklenti/Modül Yönetimi) — bkz. ARCHITECTURE.md. Fiyat Int (kuruş),
// KDV fiyata dahil, stok sayısal (checkout'ta Serializable transaction ile düşürülür, bkz.
// admin-users.routes.ts::runSerializable paterni).
model Product {
  id                 String     @id @default(uuid())
  seq                Int        @unique @default(autoincrement())
  title              String
  // §10.5 Çoklu Dil & Yerelleştirme — VARSAYILAN dilin (Locale.isDefault) kanonik
  // slug'ı. Diğer dillerin slug'ları BURADA DEĞİL, ContentSlug tablosundadır (bkz.
  // .claude/architect-scope-i18n.md §2.3, bağlayıcı karar dokümanı) — bu kolon
  // yapısal olarak DEĞİŞMEDİ, yalnızca anlamı netleştirildi.
  slug               String     @unique
  excerpt            String?
  descriptionHtml    String     @default("")
  // Para: HER ZAMAN kuruş/cent cinsinden Int — float KESİNLİKLE YOK (ödeme hassasiyeti).
  priceCents         Int
  currency           String     @default("TRY")
  // KDV fiyata DAHİL (kullanıcı kararı) — bu alan sadece FATURA/gösterim amaçlı ayrıştırma içindir.
  taxRatePercent     Decimal?   @db.Decimal(5, 2)
  discountPriceCents Int?
  sku                String?    @unique
  stockQuantity      Int        @default(0)
  status             PageStatus @default(DRAFT)
  categoryId         String?
  coverMediaId       String?
  seoTitle           String?
  seoDescription     String?
  // §10.2 Gelişmiş SEO & Social Card — bkz. ARCHITECTURE.md §10.2.
  ogTitle            String?
  ogImageUrl         String?
  canonicalUrl       String?
  noIndex            Boolean    @default(false)
  // §10.5 Çoklu Dil & Yerelleştirme — varsayılan dil (Locale.isDefault) alanları TR
  // KOLONLARDA kanonik; diğer diller `{ [locale]: { title, ... } }` şeklinde küçük harf
  // BCP-47 anahtarlarla BURADA (ör. translations.en). Ayrı bir Translation tablosu
  // BİLİNÇLİ olarak AÇILMADI (gerekçe: .claude/architect-scope-i18n.md §1.2). Slug bu
  // JSON'da TUTULMAZ — bkz. ContentSlug modeli (§1.3).
  translations       Json       @default("{}")
  publishedAt        DateTime?
  // Zamanlanmış yayın hedef tarihi — yalnızca status=SCHEDULED iken anlamlı; süreç-içi sweeper bu
  // tarihe ulaşınca status'u PUBLISHED'a çevirir (bkz. modules/{blog,pages}/*-publish-scheduler.ts).
  scheduledAt        DateTime?
  viewCount          Int        @default(0)
  // §10.7 Soft-delete (çöp kutusu) — bkz. ARCHITECTURE.md §10.7.
  deletedAt          DateTime?
  authorId           String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  category      ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverMedia    Media?           @relation("ProductCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  author        User?            @relation("ProductAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  images        ProductImage[]
  // §10.9.3 Sepet + Stripe Checkout — bkz. Cart/Order modelleri altındaki not.
  cartItems     CartItem[]       @relation("CartItemProduct")
  orderItems    OrderItem[]      @relation("OrderItemProduct")
  // Müşteri & E-Ticaret Alanı (Customer Portal) — bkz.
  // .claude/architect-scope-customer-portal.md §5.2.
  wishlistItems WishlistItem[]   @relation("WishlistItemProduct")

  @@index([categoryId])
  @@index([deletedAt, status])
  @@index([authorId])
  @@index([coverMediaId])
  @@map("products")
}

// Sıralı join tablosu — FooterColumn/FooterLink ile AYNI desen (bkz. yukarıdaki model).
model ProductImage {
  id        String @id @default(uuid())
  productId String
  mediaId   String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation("ProductGalleryImage", fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([mediaId])
  @@map("product_images")
}

model PortfolioCategory {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  items PortfolioItem[]

  @@map("portfolio_categories")
}

// §10.9.4 Portföy Modülü (Eklenti/Modül Yönetimi) — Ürünler modülünün (Product) BİREBİR
// paterni, manuel "order" alanıyla sıralanır (kullanıcı kararı — completedAt yerine).
model PortfolioItem {
  id             String     @id @default(uuid())
  seq            Int        @unique @default(autoincrement())
  title          String
  // §10.5 Çoklu Dil & Yerelleştirme — VARSAYILAN dilin (Locale.isDefault) kanonik
  // slug'ı. Diğer dillerin slug'ları BURADA DEĞİL, ContentSlug tablosundadır (bkz.
  // .claude/architect-scope-i18n.md §2.3, bağlayıcı karar dokümanı) — bu kolon
  // yapısal olarak DEĞİŞMEDİ, yalnızca anlamı netleştirildi.
  slug           String     @unique
  summary        String?
  contentHtml    String     @default("")
  clientName     String?
  projectUrl     String?
  completedAt    DateTime?
  order          Int        @default(0)
  status         PageStatus @default(DRAFT)
  categoryId     String?
  coverMediaId   String?
  seoTitle       String?
  seoDescription String?
  // §10.2 Gelişmiş SEO & Social Card — bkz. ARCHITECTURE.md §10.2.
  ogTitle        String?
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean    @default(false)
  // §10.5 Çoklu Dil & Yerelleştirme — varsayılan dil (Locale.isDefault) alanları TR
  // KOLONLARDA kanonik; diğer diller `{ [locale]: { title, ... } }` şeklinde küçük harf
  // BCP-47 anahtarlarla BURADA (ör. translations.en). Ayrı bir Translation tablosu
  // BİLİNÇLİ olarak AÇILMADI (gerekçe: .claude/architect-scope-i18n.md §1.2). Slug bu
  // JSON'da TUTULMAZ — bkz. ContentSlug modeli (§1.3).
  translations   Json       @default("{}")
  publishedAt    DateTime?
  // Zamanlanmış yayın hedef tarihi — yalnızca status=SCHEDULED iken anlamlı; süreç-içi sweeper bu
  // tarihe ulaşınca status'u PUBLISHED'a çevirir (bkz. modules/{blog,pages}/*-publish-scheduler.ts).
  scheduledAt    DateTime?
  viewCount      Int        @default(0)
  // §10.7 Soft-delete (çöp kutusu) — bkz. ARCHITECTURE.md §10.7.
  deletedAt      DateTime?
  authorId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  category   PortfolioCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coverMedia Media?             @relation("PortfolioCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  author     User?              @relation("PortfolioAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  images     PortfolioImage[]

  @@index([categoryId])
  @@index([deletedAt, status])
  @@index([authorId])
  @@index([coverMediaId])
  @@map("portfolio_items")
}

// Sıralı join tablosu — ProductImage ile AYNI desen (bkz. yukarıdaki model).
model PortfolioImage {
  id              String @id @default(uuid())
  portfolioItemId String
  mediaId         String
  order           Int    @default(0)

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  media         Media         @relation("PortfolioGalleryImage", fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([portfolioItemId, mediaId])
  @@index([mediaId])
  @@map("portfolio_images")
}

// §10.5 Çoklu Dil & Yerelleştirme — desteklenen diller VERİDİR, kod sabiti DEĞİL.
// Yeni dil eklemek = yeni SATIR. Migration/deploy GEREKTİRMEZ (kabul kriteri, bkz.
// .claude/architect-scope-i18n.md §2.1, bağlayıcı karar dokümanı).
model Locale {
  // BCP-47, HER ZAMAN küçük harf ("tr", "en", "de", "en-gb"). Birincil anahtar —
  // oluşturulduktan sonra DEĞİŞTİRİLEMEZ (URL uzayının ve ContentSlug'ın kimliği).
  code        String   @id
  // Panelde gösterilen ad (panel dilinde) — ör. "İngilizce".
  label       String
  // Dilin kendi adı — site dil değiştiricide BU gösterilir ("English").
  nativeLabel String
  // Kanonik dil. TAM OLARAK BİR satır true olabilir — DB seviyesinde
  // `locales_single_default` kısmi unique index'iyle zorlanır (bkz. migration SQL,
  // Prisma DSL bunu ifade edemez). Bu dil URL'de prefix ALMAZ ve içerik tablolarının
  // kanonik kolonlarında saklanır.
  isDefault   Boolean  @default(false)
  // false ise public /locales ve [lang] rota uzayında YOK; çeviriler KORUNUR.
  enabled     Boolean  @default(false)
  sortOrder   Int      @default(0)
  // hreflang override (ör. code="en" iken "en-GB"). Boşsa `code` kullanılır.
  hreflang    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contentSlugs ContentSlug[]

  @@index([enabled, sortOrder])
  @@map("locales")
}

// §10.5 — dil başına slug + "bu dilde çeviri var mı?" indeksi. Slug'lar JSON'da
// TUTULAMAZ (benzersizlik + ters arama + dilden bağımsız indeks ihtiyacı) — gerekçe:
// .claude/architect-scope-i18n.md §1.3 (bağlayıcı karar dokümanı).
//
// "Çevrildi mi?" kuralı: ayrı bir isTranslated kolonu YOKTUR — bir içerik, `L` dili için
// bir ContentSlug satırı VARSA o dilde çevrilmiş sayılır (bkz. §1.4).
model ContentSlug {
  id         String            @id @default(uuid())
  // Hangi içerik tipi — mevcut ContentEntityType enum'ı YENİDEN KULLANILIR, yeni bir
  // enum İCAT EDİLMEZ (ortak terminoloji kuralı).
  entityType ContentEntityType
  entityId   String
  locale     String
  slug       String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  localeRef Locale @relation(fields: [locale], references: [code], onDelete: Cascade)

  // URL benzersizliği — AYNI dilde AYNI slug iki kez olamaz. NOT: entityType DAHİL
  // DEĞİL — /en/about hem bir Page hem bir Product olamaz, çünkü rota uzayları
  // çakışabilir ve belirsizlik ziyaretçiye yansır.
  @@unique([locale, slug])
  // Bir içeriğin bir dilde EN FAZLA bir slug'ı olur.
  @@unique([entityType, entityId, locale])
  // "Bu içeriğin tüm dillerdeki slug'ları" (hreflang/localizations üretimi).
  @@index([entityType, entityId])
  // "Bu dilde çevrilmiş tüm X'ler" (sitemap üretimi).
  @@index([locale, entityType])
  @@map("content_slugs")
}

// Günlük bucket'lı ziyaret kaydı: pageId/postId'den yalnızca biri set edilir.
// (pageId, date, deviceType, country) ve (postId, date, deviceType, country) unique çiftleri,
// upsert ile "aynı gün + aynı cihaz + aynı ülke için ikinci görüntülemede count'u artır"
// mantığını sağlar; hem zaman serisi hem cihaz/ülke kırılımı grafikleri için temel oluşturur.
model PageView {
  id         String     @id @default(uuid())
  pageId     String?
  postId     String?
  date       DateTime
  deviceType DeviceType @default(UNKNOWN)
  // ISO 3166-1 alpha-2 ülke kodu; bilinmiyorsa "UNKNOWN" (NULL DEĞİL — Postgres unique
  // index'lerinde NULL'lar birbirinden farklı sayılır, bu da upsert'te çifte satır/race
  // condition riski yaratırdı; non-null sentinel bunu önler).
  country    String     @default("UNKNOWN")
  count      Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  page Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  post BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([pageId, date, deviceType, country])
  @@unique([postId, date, deviceType, country])
  // Tüm /admin/stats uçları `WHERE date >= :since` ile başlayıp ardından deviceType/country'ye
  // GROUP BY uyguluyor (bkz. stats.routes.ts); leading kolonu pageId/postId olan yukarıdaki
  // unique index'ler bu taramada kullanılamıyor (seq scan). deviceType/country WHERE'de
  // filtrelenmiyor, yalnızca GROUP BY'da — bu yüzden composite değil, tek kolonlu date indeksi
  // yeterli ve gereksiz büyümeden kaçınır.
  @@index([date])
  @@map("page_views")
}

enum SiteTemplate {
  SHOWCASE
  COMMERCE
  PORTFOLIO
}

// Tek satırlık (singleton) global site ayarları — id her zaman "singleton" sabiti.
model SiteSettings {
  id                  String       @id @default("singleton")
  siteName            String       @default("Site")
  logoUrl             String?
  // WP "Tagline" — footer'da logo/site adının altında gösterilir, opsiyonel
  tagline             String?
  // Header logo render yüksekliği/opsiyonel max-genişlik tavanı — footer logosu bundan
  // orantılı türetilir (frontend), ayrı bir DB kolonu YOK
  headerLogoHeight    Int? // px, null = varsayılan 32 kullanılır (frontend'de)
  headerLogoMaxWidth  Int? // px, null = sınırsız (genişlik tavanı yok)
  homePageId          String?
  // §10.9.5 Site Şablonu (Eklenti/Modül Yönetimi) — SADECE tavsiye niteliğinde: hangi
  // modüllerin/blok tiplerinin önerildiğini UI'da göstermek için kullanılır, hiçbir modülü
  // OTOMATIK açmaz/kapatmaz (bkz. ARCHITECTURE.md, kullanıcı kararı). SHOWCASE=Tanıtım Sitesi,
  // COMMERCE=Satış Sitesi, PORTFOLIO=Portföy Sitesi.
  siteTemplate        SiteTemplate @default(SHOWCASE)
  headerCtaLabel      String?
  headerCtaHref       String?
  footerCopyrightText String?
  updatedAt           DateTime     @updatedAt

  // Kök `/` rotasında render edilecek sayfa. Sayfa silinirse otomatik null'a düşer
  // (bkz. pages.routes.ts) — frontend bu durumda varsayılan (SaaS pazarlama) fallback'i gösterir.
  homePage Page? @relation(fields: [homePageId], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

enum PageHeaderStyle {
  PLAIN
  BANNER
  HIDDEN
}

// `next/font/google` derleme zamanında font adını bilmek ZORUNDA olduğundan kapalı
// enum — serbest metin DEĞİL (bkz. ARCHITECTURE.md §10.12.3). SYSTEM = harici istek
// YOK, işletim sistemi font yığını (varsayılan). Admin panelinin Geist fontu bu
// enum'dan BAĞIMSIZDIR.
enum SiteFont {
  SYSTEM
  INTER
  ROBOTO
  OPEN_SANS
  MONTSERRAT
  POPPINS
  LORA
  PLAYFAIR_DISPLAY
  SOURCE_SERIF_4
  PLUS_JAKARTA_SANS
  OUTFIT
}

enum SiteBorderRadius {
  NONE
  SM
  MD
  LG
  FULL
}

enum SiteButtonStyle {
  SOLID
  OUTLINE
  SOFT
}

// Yazı/sayfa altındaki paylaşım butonları hedefi. `SocialPlatform`'dan (sitenin
// KENDİ hesap linkleri, bkz. SocialLink) BİLİNÇLİ olarak AYRIDIR — bkz.
// ARCHITECTURE.md §10.12.1.
enum SocialShareNetwork {
  TWITTER
  FACEBOOK
  LINKEDIN
  WHATSAPP
  EMAIL
  COPY_LINK
}

// §10.12 Site Özelleştirme (WordPress Customizer benzeri görünüm paneli) — bkz.
// ARCHITECTURE.md §10.12.2. Tek satırlık (singleton) tablo, id her zaman "singleton"
// sabiti, SiteSettings ile AYNI lazy-upsert `DEFAULTS` deseni. SiteSettings'e
// KASITLI olarak DOKUNULMADI: farklı rol eşiği (bu tablonun TÜM yazma uçları
// ADMIN-only; SiteSettings PATCH bugün tek eşiğe sahip ama alan-başına RBAC bir
// anti-paterndir), GET /settings'in PUBLIC sözleşmesinin şeklini korumak (yeni
// public uç GET /appearance açıldı) ve farklı yaşam döngüsü (bu tablo
// POST /admin/appearance/reset ile bütün olarak ön ayara/fabrika değerine
// döndürülebilir — SiteSettings için böyle bir işlem anlamsızdır).
model SiteAppearance {
  id String @id @default("singleton")

  // En son uygulanan ön ayarın anahtarı — lib/appearance-presets.ts (backend-agent
  // sahipliğinde) içindeki statik kod registry'sine REFERANSTIR, FK DEĞİL
  // (MODULE_REGISTRY paterniyle AYNI, bkz. ARCHITECTURE.md §10.12.3). CANLI BİR BAĞ
  // DEĞİLDİR: elle alan değişikliğinde istemci null (özel) gönderir.
  presetKey String?

  // --- Sayfa Başlığı Düzeni ---
  pageHeaderStyle             PageHeaderStyle @default(PLAIN)
  // Yalnızca pageHeaderStyle=BANNER iken kullanılır; görsel de doluysa GÖRSEL kazanır,
  // bu renk görsel yüklenene kadarki yedek zemindir.
  pageHeaderBackgroundColor   String?
  pageHeaderBackgroundMediaId String?
  // Banner görselinin üzerine binen koyu katmanın yüzdesi (0-100), varsayılan 40.
  pageHeaderOverlayOpacity    Int             @default(40)

  // --- Renkler (SADECE ziyaretçi sitesi — admin teması AccentProvider'dan gelir,
  // bu alanlarla ASLA karışmaz, bkz. ARCHITECTURE.md §10.12.4) ---
  primaryColor    String @default("#4f46e5")
  secondaryColor  String @default("#111827")
  buttonColor     String @default("#4f46e5")
  // Buton zemini üzerindeki metin rengi — ayrı bir alandır çünkü otomatik siyah/beyaz
  // türetimi orta tonlu zeminlerde AA kontrastını güvenilir biçimde sağlayamaz.
  buttonTextColor String @default("#ffffff")
  linkColor       String @default("#4f46e5")
  accentColor     String @default("#f59e0b")
  backgroundColor String @default("#ffffff")
  surfaceColor    String @default("#f9fafb")
  textColor       String @default("#111827")
  mutedTextColor  String @default("#6b7280")

  // --- Yazı Tipi ---
  headingFont  SiteFont @default(SYSTEM)
  bodyFont     SiteFont @default(SYSTEM)
  // px, varsayılan 16. Alt sınır (Zod, backend-agent) 14 — okunabilirlik eşiği.
  baseFontSize Int      @default(16)

  // --- Bileşen Stilleri ---
  borderRadius SiteBorderRadius @default(MD)
  buttonStyle  SiteButtonStyle  @default(SOLID)

  // --- Sosyal Medya Paylaşımı — SİTENİN KENDİ hesap LİNKLERİ BURADA DEĞİL (bkz.
  // SocialLink modeli / §10.12.1). socialShareEnabled=false iken de saklanır. ---
  socialShareEnabled  Boolean              @default(false)
  socialShareNetworks SocialShareNetwork[] @default([])

  // --- Görünüm anahtarları (§10.12.5) — SiteModule/MODULE_REGISTRY BİLİNÇLİ OLARAK
  // KULLANILMAZ: bunların ne admin sayfası, ne veri modeli, ne sidebar girdisi var. ---
  backToTopEnabled       Boolean @default(true)
  stickyHeaderEnabled    Boolean @default(true)
  cookieBannerEnabled    Boolean @default(false)
  cookieBannerText       String?
  cookieBannerPolicyHref String?
  // SUNUM KATMANI anahtarıdır, GÜVENLİK/ERİŞİM kontrolü DEĞİL — yalnızca `(site)`
  // route grubunu etkiler, `/admin` BAŞKA bir route grubudur ve ASLA etkilenmez
  // (yönetici kendini kilitleyemez, bkz. ARCHITECTURE.md §10.12.5).
  maintenanceModeEnabled Boolean @default(false)
  maintenanceMessage     String?

  // --- 404 Sayfası (§10.12.7) — hepsi nullable; null ise frontend'in sabit Türkçe
  // varsayılanı kullanılır. Buton yalnızca label VE href ikisi de doluysa gösterilir. ---
  notFoundTitle       String?
  notFoundMessage     String?
  notFoundButtonLabel String?
  notFoundButtonHref  String?

  // Hiç kaydedilmemişse (satır yok) API DEFAULTS döner, bu alan null olamaz — satır
  // var olduğu an @updatedAt ile doldurulur.
  updatedAt DateTime @updatedAt

  // Medya kütüphanesinden seçim — serbest URL alanı DEĞİL (mevcut `coverMediaId`
  // paterniyle AYNI). Görsel silinirse SetNull ile boşalır, banner sessizce
  // renge/sade metne düşer (500 vermez).
  pageHeaderBackgroundMedia Media? @relation("SiteAppearancePageHeaderBackground", fields: [pageHeaderBackgroundMediaId], references: [id], onDelete: SetNull)

  @@index([pageHeaderBackgroundMediaId])
  @@map("site_appearance")
}

// §10.12.6 Özel CSS/JS — kontrattaki EN YÜKSEK RİSKLİ yüzey (kaydedilen metin her
// ziyaretçinin tarayıcısında same-origin çalışır). SiteAppearance'tan BİLİNÇLİ olarak
// AYRI tablo: yazma politikası (TÜMÜ ADMIN-only, açık onay, hız sınırı, kill switch)
// SiteAppearance'ın geri kalanından bağımsız sıkılaştırılabilsin diye (bkz.
// ARCHITECTURE.md §10.12.2 gerekçe #1, §10.12.6). sha256 özeti bu tabloda bir kolon
// olarak SAKLANMAZ — yalnızca yazma anında AuditLog.metadata'ya düşer (backend-agent);
// 50 KB'lık gövdeyi audit kaydında çoğaltmamak için kod gövdesi de audit'e yazılmaz.
model SiteCustomCode {
  id String @id @default("singleton")

  // Belgenin TAMAMI (PUT semantiği) — null/"" = kaldırıldı.
  customCss String?
  // CUSTOM_CODE_ENABLED=false (kill switch, devops-agent) iken saklanan değer
  // KORUNUR; yalnızca public GET /appearance yanıtında null'a düşer ve yazma 403'tür.
  customJs  String?

  cssUpdatedById String?
  cssUpdatedAt   DateTime?
  jsUpdatedById  String?
  jsUpdatedAt    DateTime?

  // Kullanıcı silinse de denetim satırı korunur (onDelete: SetNull) — "kim/ne zaman"
  // olay müdahalesinin (incident response) ilk adımıdır.
  cssUpdatedBy User? @relation("SiteCustomCodeCssUpdater", fields: [cssUpdatedById], references: [id], onDelete: SetNull)
  jsUpdatedBy  User? @relation("SiteCustomCodeJsUpdater", fields: [jsUpdatedById], references: [id], onDelete: SetNull)

  @@index([cssUpdatedById])
  @@index([jsUpdatedById])
  @@map("site_custom_code")
}

model NavigationItem {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  // KARDEŞ-KAPSAMLI sıra: aynı `parentId` grubu içinde 0'dan artan. Global bir sıra
  // DEĞİLDİR — tüketici önce `parentId`'ye göre gruplar, sonra `order`'a göre sıralar.
  order     Int
  label     String
  href      String
  // Hiyerarşi (WordPress menü düzenleyicisi benzeri alt menü). null = kök seviye öğe.
  // MAKSİMUM DERİNLİK 2 (kök + bir alt seviye): `parentId` dolu olan bir öğe, YALNIZCA
  // `parentId`'si null olan (kök) bir öğeyi işaret edebilir. Bu kural DB'de değil API
  // validasyonunda zorlanır (bkz. ARCHITECTURE.md §6.x Navigasyon Hiyerarşisi) — Postgres
  // CHECK ile ifade edilemez (başka satıra bakmayı gerektirir). Kural sayesinde döngü
  // (cycle) ve kendine referans yapısal olarak imkânsızdır.
  parentId  String?
  createdAt DateTime @default(now())

  // Self-relation. Cascade: bir üst öğe silinirse alt öğeleri de silinir — DB'de asla
  // öksüz (orphan) alt menü kalmaz. (PUT /admin/navigation tam-replace olduğu için pratikte
  // deleteMany({}) tetikler; cascade yine de bütünlük garantisidir.)
  parent   NavigationItem?  @relation("NavigationItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationItem[] @relation("NavigationItemHierarchy")

  @@index([order])
  // FK doğrulaması ve "bir kökün alt öğeleri" sorgusu için; ayrıca cascade delete'i hızlandırır.
  @@index([parentId])
  @@map("navigation_items")
}

enum SocialPlatform {
  TWITTER
  GITHUB
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  OTHER
}

model SocialLink {
  id        String         @id @default(uuid())
  seq       Int            @unique @default(autoincrement())
  order     Int
  platform  SocialPlatform
  url       String
  createdAt DateTime       @default(now())

  @@index([order])
  @@map("social_links")
}

model FooterColumn {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  order     Int
  title     String
  createdAt DateTime @default(now())

  links FooterLink[]

  @@index([order])
  @@map("footer_columns")
}

model FooterLink {
  id       String @id @default(uuid())
  columnId String
  order    Int
  label    String
  href     String

  column FooterColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@map("footer_links")
}

model Media {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  // Diskteki fiziksel yol (uploads/ altında) — DB kaydı silinirken dosyayı bulmak için.
  path      String
  // /uploads/... göreli URL; DTO'da PUBLIC_URL ile mutlaklaştırılır.
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  // Görsel piksel boyutu (kart üzerinde "1920×1080" etiketi için) — upload anında hesaplanır, migration ÖNCESİ yüklenmiş görsellerde null kalır, geriye dönük backfill YAPILMAZ.
  width     Int?
  height    Int?
  // a11y — editör içi içerik görseli eklerken zorunlu (bkz. modules/blog/post-editor.tsx); kapak görseli/avatar gibi diğer kullanımlarda opsiyonel.
  altText   String?
  // §10.11 Medya Kütüphanesi — Klasör Sistemi. `null` = "Kategorisiz" (bu bir klasör
  // KAYDI değil, klasörsüzlüğün ta kendisidir). Klasör silinirse SetNull ile boşalır —
  // görsel/disk dosyası ASLA silinmez (bkz. ARCHITECTURE.md §10.11.3).
  folderId  String?
  createdAt DateTime @default(now())

  folder MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  // §10.9.2 Ürünler Modülü — bkz. ARCHITECTURE.md §10.9.2.
  productCovers         Product[]        @relation("ProductCoverMedia")
  productGalleryItems   ProductImage[]   @relation("ProductGalleryImage")
  // §10.9.4 Portföy Modülü — bkz. ARCHITECTURE.md §10.9.4.
  portfolioCovers       PortfolioItem[]  @relation("PortfolioCoverMedia")
  portfolioGalleryItems PortfolioImage[] @relation("PortfolioGalleryImage")
  // §10.12.2 Site Özelleştirme — SiteAppearance.pageHeaderBackgroundMediaId için
  // zorunlu karşı-ilişki alanı.
  pageHeaderBackgrounds SiteAppearance[] @relation("SiteAppearancePageHeaderBackground")

  @@index([folderId])
  @@map("media")
}

// §10.11 Medya Kütüphanesi — Klasör Sistemi. Düz dizi + `parentId` self-relation
// (`NavigationItem` ile AYNI patern, bkz. ARCHITECTURE.md §10.11.1). MAKSİMUM DERİNLİK 2
// (kök + bir alt seviye) — Postgres CHECK başka satıra bakamadığı için DB'de ZORLANMAZ,
// API validasyon katmanında zorlanır (backend-agent). "Kategorisiz" bir klasör KAYDI
// DEĞİLDİR — `Media.folderId IS NULL`'ın ta kendisidir, sentetik satır YOK.
model MediaFolder {
  id   String @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama için
  // (diğer modellerle aynı desen); §10.11 kontratında cursor pagination kullanılmasa da
  // proje genelindeki tutarlılık için korunur.
  seq  Int    @unique @default(autoincrement())
  name String

  // Hiyerarşi. NavigationItem.parentId'nin AKSİNE (Cascade) burada `onDelete: SetNull`
  // kullanılır — klasör silinince alt klasörler CASCADE silinmez, KÖKE çıkar (architect
  // kararı, bkz. ARCHITECTURE.md §10.11.3: "hiçbir şey kaskad silinmez").
  parentId String?

  parent   MediaFolder?  @relation("MediaFolderHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("MediaFolderHierarchy")
  media    Media[]

  createdAt DateTime @default(now())

  // Savunma derinliği — SERVİS KATMANINDA zorlanan case-insensitive benzersizlik
  // kuralının YERİNE GEÇMEZ: Postgres'te NULL'lar birbirinden farklı sayıldığı için bu
  // kısıt kök seviyeyi (parentId IS NULL) KORUMAZ, ayrıca case-sensitive'dir (bkz.
  // ARCHITECTURE.md §10.11.1 "İsim benzersizliği — dikkat, DB tek başına yetmez").
  @@unique([parentId, name])
  // FK doğrulaması ve "bir kökün alt klasörleri" sorgusu için.
  @@index([parentId])
  @@map("media_folders")
}

// Admin panelindeki hassas/yetkilendirme ile ilgili aksiyonların değişmez kaydı
// (giriş denemeleri, rol/durum değişiklikleri, ayar güncellemeleri, yetkisiz erişim denemeleri).
model AuditLog {
  id         String      @id @default(uuid())
  seq        Int         @unique @default(autoincrement())
  actorId    String?
  actorEmail String?
  action     String
  status     AuditStatus @default(SUCCESS)
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}

// §10.1 İçerik Sürüm Kontrolü (Revision History) — bkz. ARCHITECTURE.md §10.1.
// entityId polymorphic (Page.id veya BlogPost.id) olduğu için gerçek bir FK/Cascade
// kurulamaz; ilgili içerik silindiğinde revizyonlar service katmanında (aynı
// transaction içinde) elle silinir.
model ContentRevision {
  id           String            @id @default(uuid())
  seq          Int               @unique @default(autoincrement())
  entityType   ContentEntityType
  entityId     String
  // Güncellemeden HEMEN ÖNCEKİ tam alan seti (bkz. ARCHITECTURE.md §10.1 için Page/BlogPost şekli).
  snapshot     Json
  editedById   String?
  // Silinen kullanıcı için okunabilir ad snapshot'ı.
  editedByName String
  createdAt    DateTime          @default(now())

  editedBy User? @relation("ContentRevisionEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@map("content_revisions")
}

// §10.3 E-posta & Bildirim Şablonu Yöneticisi — bkz. ARCHITECTURE.md §10.3.
// §10.16 Blok editörü + iletişim formu ile GENİŞLETİLDİ (yeni tablo AÇILMADI) — bkz.
// ARCHITECTURE.md §10.16.2.
enum EmailTemplatePurpose {
  WELCOME
  PASSWORD_RESET
  SYSTEM_ANNOUNCEMENT
  ORDER_CONFIRMATION
  ORG_INVITATION
  CONTACT_FORM_NOTIFICATION
  CUSTOM
}

/// RAW  = §10.3'ten devralınan ham HTML şablonu (`bodyHtml` kaynak).
/// BLOCKS = §10.16 blok editörü (`blocks` kaynak, `bodyHtml` KULLANILMAZ).
enum EmailTemplateEditorMode {
  RAW
  BLOCKS
}

model EmailTemplate {
  id                 String                  @id @default(uuid())
  seq                Int                     @unique @default(autoincrement())
  /// Yalnızca `isSystem = true` satırlarda dolu (seed idempotency'si için —
  /// `prisma/seed.ts` upsert'i `where: { key }` ile çalışmaya devam eder). Kullanıcının
  /// oluşturduğu şablonlarda `null`; Postgres unique index birden çok NULL'a izin verir.
  key                String?                 @unique
  name               String
  purpose            EmailTemplatePurpose    @default(CUSTOM)
  editorMode         EmailTemplateEditorMode @default(BLOCKS)
  /// Seed'lenmiş çekirdek şablon — SİLİNEMEZ (403), `purpose`/`key` DEĞİŞTİRİLEMEZ.
  isSystem           Boolean                 @default(false)
  /// "Kullanımda mı?" — bkz. ARCHITECTURE.md §10.16.3 aktiflik kuralı. `purpose != CUSTOM`
  /// için amaç başına EN FAZLA BİR true — bu kural EK OLARAK kısmi unique index ile
  /// DB katmanında da zorlanır (bkz. bu migration'ın `migration.sql` dosyasındaki raw SQL:
  /// `email_templates_active_purpose_key`, Prisma şemasıyla ifade edilemez).
  isActive           Boolean                 @default(false)
  subject            String
  /// Yalnızca editorMode=RAW için kaynak. BLOCKS modunda "" (render ÖNBELLEKLENMEZ).
  bodyHtml           String                  @default("")
  /// editorMode=BLOCKS kaynağı — EmailBlock[] (bkz. ARCHITECTURE.md §10.16.4).
  blocks             Json                    @default("[]")
  // Salt bilgi amaçlı — artık `lib/email-variables.ts` registry'sinden TÜRETİLİR
  // (bkz. ARCHITECTURE.md §10.16.5) ve yazma uçlarında DEĞİŞTİRİLEMEZ.
  availableVariables Json
  /// Kullanıcı tanımlı değişkenler: { key, label, sampleValue }[] (bkz. §10.16.5).
  customVariables    Json                    @default("[]")
  updatedById        String?
  updatedAt          DateTime                @updatedAt
  createdAt          DateTime                @default(now())

  updatedBy    User?         @relation("EmailTemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  contactForms ContactForm[] @relation("ContactFormNotificationTemplate")

  @@index([purpose, isActive])
  @@map("email_templates")
}

// §10.16.7 İletişim formu — bkz. ARCHITECTURE.md §10.16.7. TEK (singleton) form,
// SiteSettings/SiteAppearance ile AYNI id="singleton" + lazy-upsert deseni.
enum ContactFieldType {
  TEXT
  EMAIL
  PHONE
  TEXTAREA
  SELECT
  CHECKBOX
}

enum ContactSubmissionStatus {
  NEW
  READ
  ARCHIVED
  SPAM
}

model ContactForm {
  id                     String   @id @default("singleton")
  title                  String   @default("İletişim")
  description            String?
  submitLabel            String   @default("Gönder")
  successMessage         String   @default("Mesajınız alındı. En kısa sürede dönüş yapacağız.")
  isEnabled              Boolean  @default(true)
  /// Bildirimin gideceği adres. null ise bildirim GÖNDERİLMEZ (submission yine kaydedilir).
  notifyEmail            String?
  /// null ise purpose=CONTACT_FORM_NOTIFICATION olan aktif şablona düşülür (§10.16.3).
  notificationTemplateId String?
  // --- KVKK (compliance-agent alanı; alanlar mimar tarafından açılır, DEĞERLERİ ona aittir) ---
  consentRequired        Boolean  @default(true)
  consentText            String   @default("")
  /// Onay metnindeki "Aydınlatma Metni" bağlantısının hedefi — `Page.isLegalDocument`
  /// olan bir sayfa. Sayfa silinirse SetNull.
  consentLegalPageId     String?
  /// Gönderimlerin saklama süresi (gün). 0 = süresiz (compliance-agent onayı gerekir).
  retentionDays          Int      @default(180)
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  notificationTemplate EmailTemplate?      @relation("ContactFormNotificationTemplate", fields: [notificationTemplateId], references: [id], onDelete: SetNull)
  consentLegalPage     Page?               @relation("ContactFormConsentPage", fields: [consentLegalPageId], references: [id], onDelete: SetNull)
  updatedBy            User?               @relation("ContactFormUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  fields               ContactFormField[]
  submissions          ContactSubmission[]

  @@map("contact_forms")
}

model ContactFormField {
  id          String           @id @default(uuid())
  seq         Int              @unique @default(autoincrement())
  formId      String
  order       Int
  /// ^[a-z][a-z0-9_]{0,39}$ — e-posta şablonunda {{key}} olarak görünür (§10.16.5).
  key         String
  label       String
  type        ContactFieldType
  required    Boolean          @default(false)
  placeholder String?
  helpText    String?
  /// SELECT için { value, label }[]; diğer tiplerde [].
  options     Json             @default("[]")
  maxLength   Int?
  /// name/email/message — SİLİNEMEZ ve `key`/`type`'ı DEĞİŞTİRİLEMEZ (label/sıra serbest).
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())

  form ContactForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, key])
  @@index([formId, order])
  @@map("contact_form_fields")
}

model ContactSubmission {
  id                  String                  @id @default(uuid())
  /// Cursor sayfalama için stabil sıra (projedeki tüm listelerle aynı desen).
  seq                 Int                     @unique @default(autoincrement())
  formId              String
  /// Liste/arama ve bildirim için denormalize — `data` içinde de bulunur.
  name                String
  email               String
  /// TÜM alanların key→value anlık görüntüsü. Alan sonradan silinse bile veri korunur.
  data                Json
  status              ContactSubmissionStatus @default(NEW)
  // --- KVKK ---
  consentAt           DateTime?
  /// Gönderim ANINDA gösterilen onay metninin birebir kopyası (ispat yükümlülüğü).
  consentTextSnapshot String?
  // --- PII (30 gün sonra redakte edilir, bkz. §10.16.10) ---
  ipAddress           String?
  userAgent           String?
  piiRedactedAt       DateTime?
  // --- Bildirim ---
  notifiedAt          DateTime?
  /// SMTP hatasının kısa mesajı — gönderim BAŞARISIZ olsa da submission kaydı durur.
  notificationError   String?
  readAt              DateTime?
  readById            String?
  createdAt           DateTime                @default(now())

  form   ContactForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  readBy User?       @relation("ContactSubmissionReader", fields: [readById], references: [id], onDelete: SetNull)

  @@index([formId, status, seq])
  @@index([createdAt])
  @@map("contact_submissions")
}

// §10.4 Güvenlik & 2FA (TOTP) — tek kullanımlık yedek kurtarma kodları.
model BackupCode {
  id        String    @id @default(uuid())
  userId    String
  // sha256(code) — argon2 gerekmez, tek kullanımlık kısa kod.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

// §10.8 Toplu İçe Aktarma (Import) — bkz. ARCHITECTURE.md §10.8.2. Kuyruk YOK; bu satır
// asenkron süreç-içi worker'ın tek doğruluk kaynağıdır (bkz. ARCHITECTURE.md §10.8.1).
model ImportJob {
  id                String                   @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama için.
  seq               Int                      @unique @default(autoincrement())
  type              ImportJobType
  format            ImportSourceFormat
  status            ImportJobStatus          @default(PENDING)
  // PENDING iken null; başlatma anında seçilir.
  duplicateStrategy ImportDuplicateStrategy?
  // Kullanıcının yüklediği ORİJİNAL ad — yalnızca gösterim.
  filename          String
  // Gizli depodaki dosya referansı (rastgele UUID adı / S3 key). API'de ASLA DÖNMEZ.
  storagePath       String?
  sizeBytes         Int
  // Onay ekranını besleyen önizleme (openapi #/components/schemas/ImportJobPreview).
  preview           Json?
  // Başlatırken seçilen alan eşleştirmesi + defaultStatus/defaultAuthorId/defaultCategoryId.
  options           Json                     @default("{}")
  totalCount        Int                      @default(0)
  processedCount    Int                      @default(0)
  successCount      Int                      @default(0)
  errorCount        Int                      @default(0)
  skippedCount      Int                      @default(0)
  // Yalnızca işin TAMAMINI başarısız kılan hata; satır hataları ImportJobError'dadır.
  errorSummary      String?
  createdById       String?
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  createdBy User?            @relation("ImportJobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  errors    ImportJobError[]

  @@index([status])
  @@index([type])
  @@index([createdById])
  @@map("import_jobs")
}

// §10.8 Toplu İçe Aktarma — satır bazlı hata/atlama kaydı. Tavan 1.000/iş (bkz.
// ARCHITECTURE.md §10.8.2); aşıldığında yazma durur, errorCount saymaya devam eder.
model ImportJobError {
  id        String              @id @default(uuid())
  seq       Int                 @unique @default(autoincrement())
  jobId     String
  // Kaynak dosyadaki 1-tabanlı sıra (CSV'de başlık satırı HARİÇ).
  rowNumber Int
  // openapi #/components/schemas/ImportJobErrorCode ile BİREBİR — AuditLog.action ile aynı
  // desen: kod listesi sık büyür, serbest string DEĞİL ama enum da DEĞİL (bkz. §10.8.2).
  code      String
  message   String
  severity  ImportErrorSeverity @default(ERROR)
  field     String?
  // WXR'da wp:post_id, ZIP'te arşiv içi dosya adı, CSV/JSON'da slug/email.
  sourceRef String?
  // Satırın ham hâli, 8 KB'a KIRPILIR. KİŞİSEL VERİ İÇEREBİLİR (bkz. ARCHITECTURE.md §10.8.8).
  rawData   Json?
  createdAt DateTime            @default(now())

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, seq])
  @@map("import_job_errors")
}

// §10.8.10 Analitik Rapor Dışa Aktarma (Export) — bkz. ARCHITECTURE.md §10.8.10. Kuyruk YOK;
// ImportJob (§10.8.1) ile AYNI süreç-içi worker deseni, tek-instance varsayımıyla kullanılır.
// ImportJobError paterni burada YOK: bir export, satır satır işlenen bir toplu içe aktarma
// değil, tek seferlik rapor üretimidir — ya bütünüyle biter ya da errorSummary ile başarısız olur.
model ExportJob {
  id           String           @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama için.
  seq          Int              @unique @default(autoincrement())
  type         ExportJobType
  format       ExportFileFormat
  status       ExportJobStatus  @default(PENDING)
  // Rapor parametreleri: tarih aralığı (from/to), rol/segment filtreleri, maskeleme tercihi vb.
  filters      Json             @default("{}")
  // Gizli depodaki dosya referansı (rastgele UUID adı / S3 key). API'de ASLA DÖNMEZ.
  storagePath  String?
  // Bu export TÜRÜNÜN (USERS/REVENUE) kişisel veri alanı (e-posta vb.) İÇERİP İÇERMEDİĞİ —
  // MASKELENMİŞ olsa dahi `true`'dur (maskeleme durumu BURADA değil, `filters.unmaskPii` +
  // `reports.export.unmasked_pii` audit kaydında izlenir; bkz. compliance-agent notu,
  // ARCHITECTURE.md §10.8.10 ve reports.worker.ts::buildExportTable). compliance-agent
  // audit/erişim kararında kullanır (bkz. §10.8.8 ile aynı KVKK değerlendirme deseni).
  containsPii  Boolean          @default(false)
  createdById  String?
  // Yalnızca işin TAMAMINI başarısız kılan hata (ImportJob.errorSummary ile aynı desen).
  errorSummary String?
  // İndirme linkinin/dosyanın süre sonu — saklama süresi politikası için (bkz. §10.8.10).
  expiresAt    DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  createdBy User? @relation("ExportJobCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([createdById])
  @@map("export_jobs")
}

// §10.9 Eklenti/Modül Yönetimi — modül TANIMI kod içi statik registry'de (bkz. lib/module-registry.ts,
// backend-agent ekleyecek), burada SADECE aktif/pasif durumu + kim/ne zaman değiştirdiği tutulur. Yeni
// satır ilk toggle'da lazy upsert ile oluşur (bkz. settings.routes.ts::DEFAULTS paterni) — seed ZORUNLU
// değil, registry'deki defaultEnabled değeri satır yoksa fallback olur.
model SiteModule {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(true)
  settings    Json     @default("{}")
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SiteModuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("site_modules")
}

// §10.9.3 Sepet + Stripe Checkout (Eklenti/Modül Yönetimi) — bkz. ARCHITECTURE.md. Misafir
// checkout: Cart.tokenHash opak token'ın hash'i (bkz. lib/tokens.ts), Cart.siteUserId genelde
// NULL. Stok düşürme Serializable transaction ile yapılır (bkz. admin-users.routes.ts::
// runSerializable paterni) — checkout.session.completed webhook'unda tek transaction içinde
// stok kontrolü+düşürme+Order.status=PAID ATOMIK yapılır.
model Cart {
  id         String     @id @default(uuid())
  // Opak sepet token'ının SHA-256 hash'i (bkz. lib/tokens.ts::hashToken) — ham değer yalnızca
  // istemciye (çerez/localStorage) döner, DB'ye asla yazılmaz.
  tokenHash  String     @unique
  currency   String     @default("TRY")
  siteUserId String?
  // Genelde misafir checkout ile NULL kalır; SiteRole kullanıcısı (ör. ADMIN test amaçlı)
  // teorik olarak sepet sahibi olabilir.
  siteUser   User?      @relation("CartOwner", fields: [siteUserId], references: [id], onDelete: SetNull)
  // Terk edilmiş sepetlerin süresi dolunca süreç-içi sweeper temizler (bkz. §10.1/§10.2'deki
  // scheduledAt sweeper deseniyle aynı yaklaşım).
  expiresAt  DateTime
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([siteUserId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation("CartItemProduct", fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  // Sepete eklenme anındaki birim fiyat (kuruş) — checkout'a kadar fiyat değişikliğinden
  // etkilenmemesi için snapshot alınır (Product.priceCents/discountPriceCents ile AYNI değil).
  unitPriceCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

// compliance-agent kararı (2026-08-07, §10.9.3 Sepet + Stripe Checkout denetimi) — `Order`/
// `OrderItem` için OTOMATİK silme/anonimleştirme job'ı EKLENMEDİ (`import.retention.ts`/
// `cart-retention.ts`'teki sweeper desenlerinin AKSİNE, bilinçli bir tercih):
//
// 1. Saklama gerekçesi: Bu kayıtlar terk edilmiş bir sepet/geçici bir taslak DEĞİL,
//    tamamlanmış bir ticari işlemin kaydıdır — KVKK md.5/2-c ("bir sözleşmenin kurulması
//    veya ifasıyla doğrudan doğruya ilgili olması") ve md.5/2-ç ("veri sorumlusunun hukuki
//    yükümlülüğünün yerine getirilmesi", bkz. VUK kapsamında muhasebe belgelerinin yıllarca
//    saklanma zorunluluğu) kapsamında saklama meşrudur. Süreli bir sweeper burada YANLIŞ
//    araçtır — nihai/kesin saklama süresi (ör. N yıl) muhasebe mevzuatına bağlıdır ve bu
//    projenin (üretim değil, şablon/SaaS demo) kapsamı dışındadır; gerçek bir üretim
//    ortamında bu süre GERÇEK bir hukuk danışmanıyla teyit edilip burada netleştirilmelidir.
// 2. Veri minimizasyonu: `customerEmail`/`customerName` DIŞINDA doğrudan kişilik verisi
//    YOKTUR (adres/telefon v1 kapsamı dışında bilinçli olarak toplanmıyor) — yeni bir alan
//    eklenmeden önce compliance-agent'a danışılmalı.
// 3. Unutulma hakkı: Otomatik bir "hesabımı/verimi sil" ucu bu fazda YOK (misafir
//    checkout'ta hesap kavramı yok). Bir KVKK md.11 silme talebi gelirse admin, `customerEmail`/
//    `customerName` alanlarını MANUEL olarak anonim bir değerle (ör. "[REDACTED]") günceller;
//    `OrderItem`/tutar alanları SİLİNMEZ (muhasebe zorunluluğu devam eder, yalnızca kimliklendirici
//    alanlar temizlenir). Bu akış sık talep edilirse `POST /admin/orders/:id/anonymize` gibi
//    dedike bir uç architect onayıyla eklenebilir — şu an tek seferlik manuel işlem yeterlidir.
//
// Bu bir hukuki tavsiye DEĞİLDİR — nihai saklama süresi/anonimleştirme politikası için gerçek
// bir hukuk danışmanına başvurulmalıdır.
model Order {
  id                      String      @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama için.
  seq                     Int         @unique @default(autoincrement())
  // Müşteriye/faturaya gösterilen okunabilir sipariş numarası — üretimi backend-agent'ın işi.
  orderNumber             String      @unique
  cartId                  String?
  siteUserId              String?
  // Genelde misafir checkout ile NULL kalır; SiteRole kullanıcısı (ör. ADMIN test amaçlı)
  // teorik olarak sipariş sahibi olabilir.
  siteUser                User?       @relation("OrderCustomer", fields: [siteUserId], references: [id], onDelete: SetNull)
  customerEmail           String
  customerName            String?
  status                  OrderStatus @default(PENDING)
  currency                String
  subtotalCents           Int
  discountCents           Int         @default(0)
  // KDV fiyata DAHİL (Product.taxRatePercent ile AYNI karar) — bu alan sadece FATURA/gösterim
  // amaçlı ayrıştırma içindir, totalCents'e ayrıca eklenmez.
  taxCents                Int         @default(0)
  totalCents              Int
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?
  // Yalnızca ödeme/işlemi tamamıyla başarısız kılan hata (ImportJob.errorSummary ile AYNI desen).
  errorSummary            String?
  paidAt                  DateTime?
  // §customer-portal §5.3 — kargo alanları. `trackingNumber`: SHIPPED'a geçişte ZORUNLU
  // (uygulama katmanı, backend-agent doğrular — DB'de CHECK constraint YOK).
  // `shippingCarrier`: serbest metin, enum v1'de AÇILMAZ (kargo firması listesi site
  // sahibine göre değişir). `shippedAt`/`deliveredAt`: `paidAt` ile AYNI desen.
  trackingNumber          String?
  shippingCarrier         String?
  shippedAt               DateTime?
  deliveredAt             DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  items OrderItem[]

  @@index([status])
  @@index([siteUserId])
  @@index([stripePaymentIntentId])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  // Ürün kalıcı silinse (veya siparişten sonra değişse) bile sipariş geçmişi bozulmasın diye
  // productTitle/productSku/unitPriceCents SNAPSHOT olarak denormalize saklanır.
  product        Product? @relation("OrderItemProduct", fields: [productId], references: [id], onDelete: SetNull)
  productTitle   String
  productSku     String?
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Müşteri & E-Ticaret Alanı (Customer Portal) — bkz. .claude/architect-scope-customer-portal.md
// §5.1 (bağlayıcı karar dokümanı). Adres defteri SALT müşteri profiline aittir. `Order` ile FK
// ile BAĞLANMAZ: sipariş anındaki adres, `OrderItem`'daki fiyat/başlık snapshot mantığıyla aynı
// gerekçeyle (adres sonradan değişse/silinse bile sipariş bozulmasın) ileride `Order`'a
// DENORMALİZE kopyalanacaktır — v1'de checkout adresi Stripe tarafından toplanır, bu model onu
// ETKİLEMEZ (bkz. kapsam dışı: feature/checkout-address-from-book).
model Address {
  id           String   @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama ve "varsayılan
  // adres silinince en küçük seq'li kalan adres varsayılan olur" kuralı için (bkz. §2.2).
  seq          Int      @unique @default(autoincrement())
  userId       String
  // `onDelete: Cascade` (bilinçli, `Order.siteUser`'ın `SetNull`'undan FARKLI): adres saf
  // kişisel veridir, muhasebe değeri YOKTUR; kullanıcı kalıcı silindiğinde birlikte gitmesi
  // KVKK veri minimizasyonuyla uyumludur. Sipariş ise mali kayıttır, bu yüzden orada SetNull
  // doğrudur — bu asimetri kasıtlıdır.
  user         User     @relation("AddressOwner", fields: [userId], references: [id], onDelete: Cascade)
  title        String // "Ev", "İş" — kullanıcı etiketi
  fullName     String
  phone        String
  country      String   @default("TR")
  city         String
  district     String
  neighborhood String?
  addressLine1 String
  addressLine2 String?
  postalCode   String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Kullanıcı başına en fazla 20 adres — bu sınır backend-agent'ın route seviyesinde
  // uyguladığı bir İŞ KURALIDIR (409), DB'de CHECK/trigger constraint YOK.
  @@index([userId])
  @@map("addresses")
}

// Müşteri & E-Ticaret Alanı (Customer Portal) — bkz. .claude/architect-scope-customer-portal.md
// §5.2 (bağlayıcı karar dokümanı). Tek tablo — kapsayıcı `Wishlist` tablosu YOK: favori
// misafir/expiry/para taşımaz, `Cart`'ın ayrı kapsayıcıya ihtiyacı `tokenHash`/`currency`/
// `expiresAt` yüzündendir; favori oturum gerektirir ve süresi dolmaz → sahibi doğrudan `User`.
model WishlistItem {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  userId    String
  user      User     @relation("WishlistOwner", fields: [userId], references: [id], onDelete: Cascade)
  productId String
  // `onDelete: Cascade` (ürün silinince favori satırı gider) — `OrderItem`'ın `SetNull` +
  // snapshot deseninden FARKLIDIR ve bilinçlidir: favori bir işaretçidir, tarihsel kanıt
  // değildir, snapshot ALINMAZ.
  product   Product  @relation("WishlistItemProduct", fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Aynı ürün iki kez favorilenemez — POST idempotent davranışının (zaten varsa 200) DB temeli.
  // Kullanıcı başına en fazla 100 favori — backend-agent'ın route seviyesinde uyguladığı bir
  // İŞ KURALIDIR (409), DB'de CHECK constraint YOK.
  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

// §10.13 Üçüncü Parti Entegrasyon: API Anahtarları — bkz. ARCHITECTURE.md §10.13.2/§10.13.3.
// Bu sistem site-genelidir (SiteSettings/SiteModule ile AYNI kapsam), org bazlı DEĞİLDİR —
// SiteRole ekseninde yönetilir; bilinçli olarak organizationId/site FK'sı YOK.
model ApiKey {
  id          String       @id @default(uuid())
  seq         Int          @unique @default(autoincrement()) // cursor sayfalama
  name        String // ör. "Mobil Uygulama"
  description String?
  // Anahtarın GİZLİ OLMAYAN tanıtıcı parçası: `cmsk_<12hex>` (bkz. §10.13.3).
  // Doğrulamada indeks araması bunun üzerinden yapılır — tüm anahtarları taramak YOK.
  keyPrefix   String       @unique
  // sha256(rawKey) hex. DÜZ METİN ASLA SAKLANMAZ, geri döndürülemez (bkz. §10.13.3).
  keyHash     String       @unique
  // Ham anahtarın SON 4 karakteri — listede maskeli gösterim için. Tek başına
  // tahmin edilebilir bir bilgi taşımaz (32 byte entropinin son 16 biti).
  last4       String
  scope       ApiKeyScope  @default(READ)
  status      ApiKeyStatus @default(ACTIVE)
  lastUsedAt  DateTime?
  // MASKELENMİŞ istemci IP'si (lib/pii-mask.ts::maskIp) — sızmış anahtarı tespit
  // etmek için. HAM IP SAKLANMAZ (compliance-agent kararı, §10.13.10).
  lastUsedIp  String?
  expiresAt   DateTime? // null = süresiz
  revokedAt   DateTime?
  revokedById String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  createdBy User? @relation("ApiKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy User? @relation("ApiKeyRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdById])
  @@map("api_keys")
}

// §10.13 Üçüncü Parti Entegrasyon: Giden Webhook'lar — bkz. ARCHITECTURE.md §10.13.2/§10.13.8.
model OutboundWebhook {
  id                      String                @id @default(uuid())
  seq                     Int                   @unique @default(autoincrement())
  name                    String
  description             String?
  // SSRF doğrulamasından geçmiş mutlak https URL (§10.13.7). Şema seviyesinde
  // `String`'dir; kısıt uygulama katmanındadır (lib/ssrf-guard.ts) — DB'de ifade
  // edilemeyecek (DNS çözümlemesi gerektiren) bir kısıttır.
  url                     String
  // AES-256-GCM ile ŞİFRELİ (lib/crypto.ts::encryptSecret) — HASH DEĞİL.
  // Gerekçe §10.13.9'da: HMAC imzası için secret'ın GERİ ÇÖZÜLEBİLİR olması
  // matematiksel bir zorunluluktur; hash'lenirse imza üretilemez.
  secretEncrypted         String
  secretLast4             String
  // Postgres enum dizisi. Boş dizi YASAKTIR (en az 1 olay), uygulama katmanı zorlar.
  events                  WebhookEvent[]
  status                  OutboundWebhookStatus @default(ACTIVE)
  // Art arda başarısız gönderim sayacı; ilk başarılı gönderimde 0'a döner.
  // WEBHOOK_AUTO_DISABLE_THRESHOLD'a ulaşınca status = DISABLED (§10.13.8).
  consecutiveFailureCount Int                   @default(0)
  autoDisabledAt          DateTime?
  lastTriggeredAt         DateTime?
  lastSuccessAt           DateTime?
  lastFailureAt           DateTime?
  createdById             String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  createdBy  User?             @relation("OutboundWebhookCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([status])
  @@index([createdById])
  @@map("outbound_webhooks")
}

// §10.13 Üçüncü Parti Entegrasyon: Delivery log — bkz. ARCHITECTURE.md §10.13.2/§10.13.8.
// Bilinçli olarak YAPILMAYANLAR (aşağıdaki kararlar "eksik" DEĞİL, bağlayıcı spesifikasyondur):
// - `events` üzerinde GIN indeksi YOK: emisyon sorgusu (status=ACTIVE AND events has :event)
//   en fazla 20 satırlık bir tabloda çalışır (§10.13.8 üst sınırı); `@@index([status])` +
//   bellekte filtreleme yeterlidir.
// - Ayrı bir `WebhookDeliveryAttempt` tablosu YOK: bir gönderimin denemeleri
//   attemptCount/lastAttemptAt/responseStatus ile özetlenir (ExportJob ile AYNI gerekçe).
model WebhookDelivery {
  id                  String                @id @default(uuid())
  seq                 Int                   @unique @default(autoincrement()) // cursor sayfalama
  webhookId           String
  event               WebhookEvent
  // Gönderilen JSON gövdenin TAMAMI (zarf dahil, §10.13.9) — yeniden denemede
  // BİREBİR AYNI baytlar gönderilir; olay anındaki durum yeniden hesaplanmaz.
  payload             Json
  // Alıcının idempotency anahtarı olarak kullandığı değer `id`'dir; ayrı bir
  // `eventId` kolonu AÇILMADI (ikinci bir kimlik kavramı gereksiz).
  status              WebhookDeliveryStatus @default(PENDING)
  attemptCount        Int                   @default(0)
  maxAttempts         Int                   @default(5)
  nextAttemptAt       DateTime? // dolu ve status IN (PENDING, RETRYING) ise sweeper alır
  responseStatus      Int?
  // Alıcı yanıtının İLK 512 karakteri (uygulama katmanında kesilir). Tam gövde
  // ASLA saklanmaz — alıcı hata sayfasında kendi iç bilgisini sızdırabilir.
  responseBodySnippet String?
  // Makine-okunur hata sınıfı: "timeout" | "dns_failure" | "connection_refused" |
  // "tls_error" | "redirect_not_followed" | "ssrf_blocked" | "http_error" | "unknown"
  errorCode           String?
  errorMessage        String?
  durationMs          Int?
  // Payload kişisel veri içeriyor mu (ORDER_* olayları: müşteri e-postası/adı).
  // `ExportJob.containsPii` ile AYNI amaç ve AYNI saklama mantığı (§10.13.10).
  containsPii         Boolean               @default(false)
  // Elle yeniden gönderimde (redeliver) kaynak kaydın id'si — denetim izi.
  redeliveryOfId      String?
  firstAttemptAt      DateTime?
  lastAttemptAt       DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime              @default(now())

  webhook OutboundWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  // Delivery log listesi HER ZAMAN tek bir webhook kapsamında ve `seq desc`
  // sıralıdır — bu bileşik indeks o sorgunun tamamını karşılar.
  @@index([webhookId, seq])
  // Sweeper'ın sıcak sorgusu: WHERE status IN (...) AND nextAttemptAt <= now().
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}
