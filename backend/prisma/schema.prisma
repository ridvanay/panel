// docs/architecture/ARCHITECTURE.md (bölüm 6, ER diyagramı) ve openapi.yaml ile
// birebir uyumlu tutulmalıdır. Alan/enum değişikliği önce oradaki dokümanlara yansır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

// `/admin/*` CMS uçları için org'dan bağımsız site-geneli rol/durum — MembershipRole ile
// KARIŞTIRILMAMALI, tamamen ayrı bir yetkilendirme ekseni (bkz. middleware/site-rbac.ts).
enum SiteRole {
  ADMIN
  EDITOR
  VIEWER
}

enum SiteUserStatus {
  ACTIVE
  SUSPENDED
}

enum AuditStatus {
  SUCCESS
  FAILURE
  FORBIDDEN
}

enum DeviceType {
  MOBILE
  DESKTOP
  TABLET
  UNKNOWN
}

model User {
  id              String         @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama için.
  seq             Int            @unique @default(autoincrement())
  email           String         @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  emailVerifiedAt DateTime?
  role            SiteRole       @default(VIEWER)
  status          SiteUserStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  ownedOrganizations  Organization[]        @relation("OrganizationOwner")
  memberships         Membership[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  blogPosts            BlogPost[]
  auditLogs            AuditLog[]            @relation("AuditLogActor")

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  // Sıralı, dış dünyaya sızmayan iç sayaç — cursor sayfalamada stabil sıralama için.
  seq       Int      @unique @default(autoincrement())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation("OrganizationOwner", fields: [ownerId], references: [id])
  memberships  Membership[]
  invitations  Invitation[]
  subscription Subscription?

  @@map("organizations")
}

model Membership {
  id             String           @id @default(uuid())
  seq            Int              @unique @default(autoincrement())
  userId         String
  organizationId String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           MembershipRole
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Aynı e-posta için birden fazla PENDING davet olmasın kontrolü uygulama
  // katmanında yapılır (Prisma koşullu/kısmi unique index'i desteklemiyor).
  @@index([organizationId, email])
  @@map("invitations")
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  priceMonthlyCents    Int
  priceYearlyCents     Int
  currency             String   @default("TRY")
  limits               Json     @default("{}")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique
  planId               String
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// Opak refresh token'ın SHA-256 hash'i saklanır, ham değer asla DB'ye yazılmaz.
model RefreshToken {
  id                  String    @id @default(uuid())
  userId              String
  tokenHash           String    @unique
  expiresAt           DateTime
  revoked             Boolean   @default(false)
  replacedByTokenHash String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Tek site (global) kapsamında: organizationId yok, herhangi bir authenticated kullanıcı yönetir.
model Page {
  id             String     @id @default(uuid())
  seq            Int        @unique @default(autoincrement())
  title          String
  slug           String     @unique
  status         PageStatus @default(DRAFT)
  // Sayfa builder blokları — sıralı JSON dizi, şekli frontend'de lib/page-builder/types.ts::Block ile eşleşir.
  blocks         Json       @default("[]")
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  // Denormalize toplam sayaç — admin liste/detay ekranlarında ekstra sorgu gerektirmeden okunur.
  viewCount      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  views        PageView[]
  siteSettings SiteSettings[]

  @@map("pages")
}

model BlogCategory {
  id        String     @id @default(uuid())
  seq       Int        @unique @default(autoincrement())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogPost {
  id            String     @id @default(uuid())
  seq           Int        @unique @default(autoincrement())
  title         String
  slug          String     @unique
  excerpt       String?
  contentHtml   String     @default("")
  coverImageUrl String?
  status        PageStatus @default(DRAFT)
  categoryId    String?
  authorId      String?
  publishedAt   DateTime?
  viewCount     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  views    PageView[]

  @@index([categoryId])
  @@map("blog_posts")
}

// Günlük bucket'lı ziyaret kaydı: pageId/postId'den yalnızca biri set edilir.
// (pageId, date, deviceType, country) ve (postId, date, deviceType, country) unique çiftleri,
// upsert ile "aynı gün + aynı cihaz + aynı ülke için ikinci görüntülemede count'u artır"
// mantığını sağlar; hem zaman serisi hem cihaz/ülke kırılımı grafikleri için temel oluşturur.
model PageView {
  id         String     @id @default(uuid())
  pageId     String?
  postId     String?
  date       DateTime
  deviceType DeviceType @default(UNKNOWN)
  // ISO 3166-1 alpha-2 ülke kodu; bilinmiyorsa "UNKNOWN" (NULL DEĞİL — Postgres unique
  // index'lerinde NULL'lar birbirinden farklı sayılır, bu da upsert'te çifte satır/race
  // condition riski yaratırdı; non-null sentinel bunu önler).
  country    String     @default("UNKNOWN")
  count      Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  page Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  post BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([pageId, date, deviceType, country])
  @@unique([postId, date, deviceType, country])
  @@map("page_views")
}

// Tek satırlık (singleton) global site ayarları — id her zaman "singleton" sabiti.
model SiteSettings {
  id                  String   @id @default("singleton")
  siteName            String   @default("Site")
  logoUrl             String?
  homePageId          String?
  headerCtaLabel      String?
  headerCtaHref       String?
  footerCopyrightText String?
  updatedAt           DateTime @updatedAt

  // Kök `/` rotasında render edilecek sayfa. Sayfa silinirse otomatik null'a düşer
  // (bkz. pages.routes.ts) — frontend bu durumda varsayılan (SaaS pazarlama) fallback'i gösterir.
  homePage Page? @relation(fields: [homePageId], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model NavigationItem {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  order     Int
  label     String
  href      String
  createdAt DateTime @default(now())

  @@index([order])
  @@map("navigation_items")
}

enum SocialPlatform {
  TWITTER
  GITHUB
  LINKEDIN
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  OTHER
}

model SocialLink {
  id        String         @id @default(uuid())
  seq       Int            @unique @default(autoincrement())
  order     Int
  platform  SocialPlatform
  url       String
  createdAt DateTime       @default(now())

  @@index([order])
  @@map("social_links")
}

model FooterColumn {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  order     Int
  title     String
  createdAt DateTime @default(now())

  links FooterLink[]

  @@index([order])
  @@map("footer_columns")
}

model FooterLink {
  id       String @id @default(uuid())
  columnId String
  order    Int
  label    String
  href     String

  column FooterColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId])
  @@map("footer_links")
}

model Media {
  id        String   @id @default(uuid())
  seq       Int      @unique @default(autoincrement())
  // Diskteki fiziksel yol (uploads/ altında) — DB kaydı silinirken dosyayı bulmak için.
  path      String
  // /uploads/... göreli URL; DTO'da PUBLIC_URL ile mutlaklaştırılır.
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@map("media")
}

// Admin panelindeki hassas/yetkilendirme ile ilgili aksiyonların değişmez kaydı
// (giriş denemeleri, rol/durum değişiklikleri, ayar güncellemeleri, yetkisiz erişim denemeleri).
model AuditLog {
  id         String      @id @default(uuid())
  seq        Int         @unique @default(autoincrement())
  actorId    String?
  actorEmail String?
  action     String
  status     AuditStatus @default(SUCCESS)
  targetType String?
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}
