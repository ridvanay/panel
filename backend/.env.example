# Sunucu
NODE_ENV=development
PORT=4000
# Ana vitrin/e-ticaret sitesinin TARAYICIYA görünen origin'i — CORS `origin` allow-list'ini
# (plugins/security.ts) VE kullanıcıya giden e-posta/checkout/davet linklerini besler. Host
# şeması `.claude/architect-scope-doctor-subdomain.md` §6.3/§6.4 kararınca `siteadi.localhost`'a
# taşındı (`*.localhost` zincirini tarayıcı otomatik 127.0.0.1'e çözer, hosts dosyası GEREKMEZ).
# E2E'de (backend/.env.e2e) port :3100'dür.
FRONTEND_URL=http://siteadi.localhost:3000
# Hekim portalı (`/doctor/**`) subdomain izolasyonu — YENİ, opsiyonel (mekanizma: TANIMSIZ/
# yorum-satırı bırakılırsa hekim host'undan gelen istekler CORS'ta reddedilir ve frontend
# tarafındaki subdomain özelliği de -- NEXT_PUBLIC_DOCTOR_URL tanımsızsa -- zaten devre dışı
# olduğundan bu geriye dönük uyumluluğu BOZMAZ). Bu şablonda ÖZELLİĞİ AKTİF örneklemek için
# uncomment edilmiş hâlde bırakıldı (`.claude/architect-scope-doctor-subdomain.md` §6.4).
# FRONTEND_URL ile BİRLİKTE CORS allow-list'e eklenir
# (`origin: [env.FRONTEND_URL, env.DOCTOR_FRONTEND_URL].filter(Boolean)`, backend-agent'ın işi).
# `FRONTEND_URL` ile AYNI kayıt edilebilir üst alan adı (`siteadi.localhost`) altında olmalı
# (§6.2 — refresh çerezi SameSite=Strict, farklı bir eTLD+1 olursa taşınmaz). E2E'de port
# :3100'dür.
DOCTOR_FRONTEND_URL=http://doktor.siteadi.localhost:3000
# Yalnızca lib/revalidate.ts'in sunucudan-sunucuya on-demand ISR webhook çağrısı için —
# Docker Compose'da "http://frontend:3000" (bkz. docker-compose.yml). TANIMSIZ bırakılırsa
# FRONTEND_URL'e düşer (tek-host geliştirmede genelde HİÇ gerekmez) — z.string().url() boş
# string'i GEÇERSİZ sayar, bu yüzden burada satır TAMAMEN yorum satırı bırakılır, "KEY=" ile
# boş değer ATANMAZ.
# INTERNAL_FRONTEND_URL=http://frontend:3000
# Yüklenen medya dosyalarının mutlak URL'lerini oluşturmak için kullanılır (/uploads statik
# servisi bu origin'den sunulur). Aynı host şeması geçişine tabidir. E2E'de port :4001'dir.
# ZORUNLU (varsayılan YOK) — production'da backend'in gerçek genel erişilebilir origin'ine
# ayarlanmalıdır, aksi halde boot reddedilir (bkz. config/env.ts).
PUBLIC_URL=http://siteadi.localhost:4000

# Veritabanı
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_dev?schema=public

# Fastify trustProxy — request.ip / rate-limit / audit log'un `X-Forwarded-*` header'larına
# ne zaman güvenileceğini belirler. Production'da önde güvenilir bir reverse-proxy
# (nginx/ALB/Cloudflare vb.) varsa "true" veya proxy'nin IP/CIDR'ını yazın; yoksa (veya emin
# değilseniz) boş/"false" bırakın — aksi halde istemciler sahte header ile IP'lerini taklit
# edip rate-limit/audit log kayıtlarını atlatabilir.
TRUST_PROXY=false

# JWT (RS256) — PEM içeriklerini base64'e çevirip yapıştırın:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem  (Windows: certutil -encode private.pem tmp.b64)
# NODE_ENV=development iken boş bırakılırsa süreç içi geçici anahtar çifti üretilir (yeniden başlatınca eski access token'lar geçersiz olur).
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# LiveKit (Tele-Sağlık — görüntülü konsültasyon) — bkz.
# .claude/architect-scope-telehealth-template.md §4.4. STRIPE_* ile BİREBİR AYNI opsiyonel
# desen: üçü de boş bırakılırsa görüşme özelliği devre dışı kalır, `POST
# /appointments/{id}/meeting-token` ucu `503 LIVEKIT_NOT_CONFIGURED` döner (hata değil, dürüst
# bir durum).
#
# GÜNCELLEME (2026-09-15, devops-agent — bilinçli mimari karar TERSİNE ÇEVİRMESİ): önceki not
# ("LiveKit SUNUCUSU/SFU bu compose'a DAHİL DEĞİLDİR ve self-host EDİLMEYECEKTİR") artık GEÇERLİ
# DEĞİL. Kök `docker-compose.yml` artık YEREL/self-hosted bir `livekit` servisi (resmi
# `livekit/livekit-server` imajı, `--dev` modu) İÇERİYOR — bu, LiveKit Cloud/harici kurulumun
# YERİNE geçmez, yerel geliştirme için isteğe bağlı EK bir seçenektir. `docker compose up`
# kullanıyorsanız aşağıdaki üç değer, kök compose dosyasının `backend.environment` bloğunda ZATEN
# override edilir (`ws://siteadi.localhost:7880` / `devkey` / `secret_livekit_local_dev_key_32bytes`)
# — bu satırları elle doldurmanıza GEREK YOK. Bare-metal (`npm run dev`, container'sız) çalışıyorsanız
# aynı üç değeri buraya kopyalayıp `docker compose up livekit` (yalnızca LiveKit servisini) ayrıca
# ayağa kaldırabilirsiniz. **Production'da HÂLÂ LiveKit Cloud (https://cloud.livekit.io) veya
# doğru şekilde ölçeklenmiş, harici bir kurulum ÖNERİLİR** — `--dev` modu tek-node, TURN'süz,
# yalnızca yerel geliştirme içindir, prod trafiği için kullanılmamalıdır.
LIVEKIT_URL=            # yerel Docker: ws://siteadi.localhost:7880 — prod: wss://<proje>.livekit.cloud
LIVEKIT_API_KEY=        # yerel Docker: devkey
LIVEKIT_API_SECRET=     # yerel Docker: secret_livekit_local_dev_key_32bytes
LIVEKIT_TOKEN_TTL_MIN=180  # dk — görüşme süresine yakın tutulur (tavan 240), aksi halde token dolunca LiveKit odadan atar
LIVEKIT_ROOM_EMPTY_TIMEOUT_SEC=300    # sn — hiçbir katılımcı katılmadan oda açık kalır (RoomServiceClient.createRoom, ensureRoomConfigured)
LIVEKIT_ROOM_DEPARTURE_TIMEOUT_SEC=60 # sn — son katılımcı ayrıldıktan sonra oda açık kalır (yeniden katılma toleransı), sonra kendiliğinden kapanır
# BACKEND KONTEYNERİNDEN erişilebilir Server API adresi (http(s)://) — LIVEKIT_URL'den (tarayıcı
# ws(s)://) BİLİNÇLİ OLARAK AYRI: backend konteynerinin DNS çözümleyicisi *.localhost'u ÇÖZEMEZ
# (yalnızca tarayıcı çözer). Boş bırakılırsa ensureRoomConfigured() SESSİZCE atlanır (oda yine
# LiveKit'in kendi varsayılan timeout'larıyla otomatik oluşur — hata değil).
# `docker compose up` (kök docker-compose.yml): http://livekit:7880 (ZATEN backend.environment
# bloğunda override edilir, burayı elle doldurmanıza GEREK YOK).
# Bare-metal/prod: LiveKit backend İLE AYNI sunucuda ise http://127.0.0.1:<port> (nginx'i ATLAR);
# farklı bir host/ağdaysa oradan gerçekten erişilebilir bir adres.
LIVEKIT_INTERNAL_URL=

# Sunucu tarafı görüşme kaydı (LiveKit Egress, TUR 3) — S3_* ile BİRLİKTE ZORUNLU, aksi halde
# kayıt özelliği "yapılandırılmamış" sayılır (503 RECORDING_NOT_CONFIGURED). Egress backend
# konteynerinin DIŞINDA çalıştığı için S3_ENDPOINT docker-içi bir adresse (ör. http://minio:9000)
# buraya dışarıdan erişilebilir bir adres yazın; boş bırakılırsa S3_ENDPOINT kullanılır.
LIVEKIT_EGRESS_S3_ENDPOINT=
# LiveKit'in `egress_started/updated/ended` olaylarını POST edeceği MUTLAK URL, örn.
# https://api.example.com/api/v1/webhooks/livekit
LIVEKIT_EGRESS_WEBHOOK_URL=

# On-demand ISR — sayfa/blog vb. kaydedildiğinde frontend'in POST /api/revalidate ucunu
# tetiklemek için backend ve frontend'in PAYLAŞTIĞI sır (bkz. src/lib/revalidate.ts).
# Boş bırakılırsa revalidation çağrısı hiç yapılmaz (60sn'lik zaman-tabanlı ISR'a geri düşülür),
# sayfa kaydetme akışı ETKİLENMEZ. Üretmek için: openssl rand -hex 32
REVALIDATE_SECRET=

# Rate limit
# Global limit — hassas uçlar (login/2FA vb.) zaten route-level olarak 5/dk'ya sıkılaştırılıyor,
# bu değer sadece genel GET/liste uçlarını korur (bkz. config/env.ts açıklaması).
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Tele-Sağlık — ÖZEL (private) belge deposu, sağlık verisi (şikâyet notu ekleri, reçete/tahlil/
# radyoloji belgeleri — bkz. .claude/architect-scope-telehealth-template.md §9.7.5 KARAR J ve
# .claude/compliance-notes-telehealth.md "TUR 2" KRİTİK ŞART).
# BAĞLAYICI: bu dizin `UPLOAD_DIR`'ın (backend/src/plugins/uploads.ts:10,
# `path.join(process.cwd(), "uploads")`) ALT DİZİNİ OLAMAZ — `@fastify/static`, `root: UPLOAD_DIR`
# altındaki HER ŞEYİ (alt klasörler dahil) `/uploads/**` üzerinden kimlik doğrulamasız servis eder;
# `uploads/private` gibi bir yol yazarsanız tüm KVKK md.6 özel nitelikli veri koruması sessizce
# delinir. Bu yüzden `UPLOAD_DIR`'ın KARDEŞİ (aynı üst dizinin farklı bir alt klasörü, "storage/"),
# ayrı bir Docker volume ile mount edilir — bkz. docker-compose.yml, backend/Dockerfile, INFRA.md.
# Yalnızca `GET /appointments/documents/{documentId}/content` üzerinden, yetkilendirmeden geçerek
# servis edilir (backend-agent'ın işi, bu tur itibarıyla henüz yazılmadı).
PRIVATE_UPLOAD_DIR=./storage/private-uploads

# Medya depolama
# STORAGE_DRIVER=local (varsayılan, diske yazar) veya STORAGE_DRIVER=s3
STORAGE_DRIVER=local
# Aşağıdakiler yalnızca STORAGE_DRIVER=s3 iken gereklidir:
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO/Cloudflare R2 gibi S3-uyumlu servisler için özel uç nokta (AWS S3 kullanıyorsanız boş bırakın):
S3_ENDPOINT=
# CDN/CloudFront base URL — tanımlıysa medya URL'leri bundan üretilir (örn. https://cdn.example.com):
S3_PUBLIC_URL=

# Sistem sağlığı (GET /admin/health)
# Tanımlıysa /admin/health "doluluk yüzdesi" hesaplar; tanımsızsa frontend sadece mutlak boyutu gösterir.
DB_STORAGE_QUOTA_MB=
MEDIA_STORAGE_QUOTA_MB=

# §10.4 Güvenlik & 2FA — TOTP secret şifrelemesi için AES-256-GCM anahtarı (32 byte, base64).
# Üretmek için: openssl rand -base64 32
ENCRYPTION_KEY=

# E-posta gönderimi (SMTP) — bkz. src/lib/mail.ts. Sağlayıcı agnostiktir: Mailtrap/SendGrid SMTP/
# Resend SMTP/kurumsal SMTP dahil herhangi bir SMTP sağlayıcısı burada çalışır.
# Boş bırakılırsa: NODE_ENV=development'ta otomatik bir Ethereal (ethereal.email) test hesabı
# oluşturulur (hiçbir kurulum gerekmez) — production'da ZORUNLUDUR, aksi halde gönderim
# denendiğinde EmailDeliveryError (502) döner.
SMTP_HOST=
SMTP_PORT=587
# "true" veya "false" (465 gibi implicit TLS portları için true, 587/STARTTLS için false)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Gönderen adı + adresi, örn. "Şirket Adı <no-reply@example.com>"
SMTP_FROM=No-Reply <no-reply@example.com>

# Hata takibi (Sentry veya uyumlu bir self-hosted alternatif — örn. GlitchTip — aynı DSN
# formatını kullanır). Boş bırakılırsa Sentry HİÇ init edilmez (varsayılan KAPALI), hiçbir
# hata dışarı gönderilmez — bkz. src/lib/sentry.ts. Sadece beklenmedik (500) hatalar gönderilir;
# bilinen/ele alınmış hatalar (validation, 404, 429 vb.) hiç gitmez. PII (email, ham request
# body/query string) ASLA gönderilmez, sadece kullanıcı id'si + rolü ve route pattern'i.
SENTRY_DSN=
# Boş bırakılırsa NODE_ENV kullanılır (development/test/production).
SENTRY_ENVIRONMENT=
# 0 ile 1 arası — performans/trace örnekleme oranı (0 = trace kapalı, sadece hata yakalama).
SENTRY_TRACES_SAMPLE_RATE=0

# §10.12.6 Site Özelleştirme — Özel CSS/JS kill switch. "false" yapılırsa PUT
# /admin/appearance/custom-code/{css,js} 403 döner ve public GET /appearance customJs HER ZAMAN
# null verir (saklı değer korunur, yalnızca yazma/public görünürlük kapanır). Barındırılan/çok
# kiracılı bir kurulumda keyfi JS'i olay anında tek kaldıraçla kapatmak için.
CUSTOM_CODE_ENABLED=true
