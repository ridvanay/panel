# Sunucu
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Yüklenen medya dosyalarının mutlak URL'lerini oluşturmak için kullanılır (/uploads statik servisi bu origin'den sunulur).
PUBLIC_URL=http://localhost:4000

# Veritabanı
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_dev?schema=public

# JWT (RS256) — PEM içeriklerini base64'e çevirip yapıştırın:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem  (Windows: certutil -encode private.pem tmp.b64)
# NODE_ENV=development iken boş bırakılırsa süreç içi geçici anahtar çifti üretilir (yeniden başlatınca eski access token'lar geçersiz olur).
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Rate limit
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
