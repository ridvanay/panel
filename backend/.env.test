# Testler için — docker-compose'daki aynı Postgres servisi, ayrı bir veritabanı (saas_test).
# global-setup.ts bu veritabanını gerekirse oluşturup migrate eder.
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_test?schema=public
FRONTEND_URL=http://localhost:3000
# CORS allow-list testi (tests/integration/security.test.ts) için — bkz.
# `.claude/architect-scope-doctor-subdomain.md` §6.4/§7.2. Gerçek bir hekim portalı süreci
# ayağa kalkmaz; yalnızca `plugins/security.ts`'in allow-list'e ikinci bir sabit origin
# eklediğini doğrulamak için kullanılır.
DOCTOR_FRONTEND_URL=http://doktor.localhost:3000
PUBLIC_URL=http://localhost:4000
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=1 minute
# Webhook imza doğrulama testleri (bkz. tests/integration/webhook-order.test.ts) — gerçek bir
# Stripe hesabına bağlı DEĞİL, yalnızca constructEvent/generateTestHeaderString'in kullandığı
# yerel HMAC hesaplaması için sabit bir test secret'ı.
STRIPE_WEBHOOK_SECRET=whsec_test_secret_for_integration_tests

# On-demand ISR (bkz. src/lib/revalidate.ts) — testlerde frontend süreci ayağa kalkmadığı için
# fetch() gerçek bir sunucuya ulaşamaz; her çağrı `try/catch` içinde best-effort olduğundan bu
# sabit test değeri testleri KIRMAZ (istek başarısız olursa yalnızca warn loglanır).
REVALIDATE_SECRET=test-revalidate-secret

# E-posta (SMTP) ayarları testleri (tests/integration/settings-email.test.ts) — `127.0.0.1` gibi
# bir loopback host'u SSRF ağ-katmanı reddi OLMADAN kaydedebilmek/test edebilmek için escape hatch
# açılır (bkz. `.claude/security-review-smtp-settings.md` KARAR 2.4: "hangi ortamda true olacağına
# devops-agent karar verir" — test ortamı için karar budur). Testler bu host'a GERÇEKTEN bağlanmaya
# çalışır (`POST .../email/test`) ve dinleyen bir servis olmadığı için hızlı/deterministik bir
# ECONNREFUSED alır — dış ağ/DNS erişimine BAĞIMLI DEĞİLDİR.
SMTP_ALLOW_PRIVATE_HOST=true
