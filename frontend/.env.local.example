# backend/ servisinin adresi (docs/architecture/openapi.yaml, base path /api/v1 dahil)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Sitenin kendi origin'i — sitemap.xml/robots.txt için mutlak URL üretiminde kullanılır
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hata takibi (Sentry veya uyumlu bir self-hosted alternatif — örn. GlitchTip). Boş bırakılırsa
# Sentry HİÇ init edilmez (varsayılan KAPALI) — bkz. src/instrumentation-client.ts,
# src/sentry.server.config.ts, src/sentry.edge.config.ts. `NEXT_PUBLIC_` prefix'i OLMAYANLAR
# (SENTRY_DSN, SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN) yalnızca sunucu tarafında/
# build-time'da okunur, tarayıcıya asla gönderilmez.
# Tarayıcıda (client) çalışan hataları yakalamak için:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Next.js sunucu tarafı (Server Component/Route Handler/Server Action) hataları için — genelde
# NEXT_PUBLIC_SENTRY_DSN ile AYNI DSN kullanılabilir (Sentry'de tek bir Next.js projesi
# hem client hem server event'lerini kabul eder), ama Sentry backend/ için ayrı bir proje
# öneriyorsa burada backend'in kendi DSN'i DEĞİL, bu frontend servisinin DSN'i olmalı.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Yalnızca CI/production build'lerinde source map yükleme (okunaklı stack trace) için — İSTEĞE
# BAĞLIDIR, boş bırakılırsa build sorunsuz çalışır, sadece Sentry'deki stack trace'ler minify
# edilmiş kalır. Sentry.io → Settings → Auth Tokens'tan alınır.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
