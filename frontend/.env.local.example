# backend/ servisinin TARAYICIYA görünen adresi (docs/architecture/openapi.yaml, base path
# /api/v1 dahil). Host şeması `.claude/architect-scope-doctor-subdomain.md` §6.3/§6.4
# kararınca `siteadi.localhost`'a taşındı — `*.localhost` zincirini tarayıcı otomatik
# 127.0.0.1'e çözer (hosts dosyası GEREKMEZ), ama Node.js'in kendi çözümleyicisi bunu
# ÇÖZEMEZ (bkz. aşağıdaki INTERNAL_API_URL notu). E2E'de (playwright.config.ts) port :4001'dir.
NEXT_PUBLIC_API_URL=http://siteadi.localhost:4000/api/v1
# Medyanın (ürün görselleri, doktor avatarı vb.) TARAYICIYA görünen host'u — YALNIZCA backend
# `STORAGE_DRIVER=s3` iken (S3/CDN, `NEXT_PUBLIC_API_URL`'den TAMAMEN FARKLI bir host) doldurun.
# `STORAGE_DRIVER=local` iken (varsayılan, medya backend'in kendisinden `/uploads/*` üzerinden
# servis edilir) BOŞ bırakın — `NEXT_PUBLIC_API_URL` zaten yeterlidir, next.config.ts::
# buildImageRemotePatterns() bu host'u otomatik kapsar. `next.config.ts::buildImageRemotePatterns`
# ve `src/lib/image-hosts.ts::collectAllowedHosts` AYNI değişkene bakar (`.claude/
# architect-scope-products-catalog.md` §6.1) — burada BOŞ bırakılırsa ve backend GERÇEKTE S3/CDN
# kullanıyorsa next/image o host'u remotePatterns'te GÖRMEZ, `SafeImage` sessizce düz `<img>`'e
# düşer (build/runtime KIRILMAZ, optimize edilmemiş ama görünür görsel). Tanımlıysa host,
# `NEXT_PUBLIC_API_URL`/`NEXT_PUBLIC_INTERNAL_MEDIA_URL` ile ÇAKIŞMAMALI (aynı host ise zaten
# gereksiz, çakışan hostname'ler `seenHosts` tarafından sessizce tekilleştirilir, zararsız ama
# gereksiz).
NEXT_PUBLIC_MEDIA_URL=
# Sitenin kendi origin'i — sitemap.xml/robots.txt için mutlak URL üretiminde kullanılır.
# E2E'de port :3100'dür.
NEXT_PUBLIC_SITE_URL=http://siteadi.localhost:3000
# Hekim portalı (`/doctor/**`) subdomain izolasyonu — YENİ, opsiyonel
# (`.claude/architect-scope-doctor-subdomain.md` §3.4/§6). TANIMSIZ bırakılırsa özelliğin
# TAMAMI (proxy dalı, host yönlendirmesi) devre dışı kalır ve `/doctor` ana domain'de eskisi
# gibi çalışır — geriye dönük uyumluluk bağlayıcıdır. `NEXT_PUBLIC_SITE_URL` ile AYNI
# kayıt edilebilir üst alan adı (`siteadi.localhost`) altında olmalı, aksi halde refresh
# çerezi (SameSite=Strict) taşınmaz ve hekim oturumu sayfa yenilemesinde ölür (§6.1 deneyi).
# E2E'de port :3100'dür.
NEXT_PUBLIC_DOCTOR_URL=http://doktor.siteadi.localhost:3000

# Next.js SUNUCU tarafı kodunun (Server Component'ler, proxy.ts, lib/api/server-*.ts,
# next/image optimize edici) backend'e erişmek için kullandığı adresler — Node.js'in OS
# çözümleyicisi `*.localhost` zincirini ÇÖZEMEZ (tarayıcı çözer, Node ÇÖZMEZ; Windows'ta
# `ENOTFOUND` ile doğrulandı, bkz. `.claude/architect-scope-doctor-subdomain.md` §6.1/§6.4).
# Bu yüzden `siteadi.localhost` host şemasına geçişle birlikte bare-metal `npm run dev`'de
# bu iki değişken ZORUNLU hale geldi (öncesinde yalnızca Docker'da gerekiyordu, çünkü
# `localhost` her yerde çözülüyordu). Docker Compose'da bu değerler `docker-compose.yml`'in
# `environment:`/`build.args` bloklarında `backend:4000` olarak OVERRIDE edilir — burası
# yalnızca bare-metal/E2E içindir.
# E2E'de port :4001'dir.
INTERNAL_API_URL=http://localhost:4000/api/v1

# LiveKit (Tele-Sağlık) — yalnızca sunucunun WebSocket adresi (backend/.env'deki LIVEKIT_URL
# ile AYNI değer). API secret ASLA frontend'e geçmez/geçirilmez — token backend'de
# (integration-agent'ın lib/livekit.ts'i) üretilir, frontend onu uçtan alır (bkz.
# .claude/architect-scope-telehealth-template.md §4.4). Boş bırakılırsa (backend tarafı da
# yapılandırılmamışsa) konsültasyon sayfası "yapılandırılmamış" durum panelini gösterir.
NEXT_PUBLIC_LIVEKIT_URL=

# next/image'in KENDİ sunucu-taraflı optimize fetch'inin (frontend sürecinin İÇİNDE çalışır,
# `/_next/image` route'u) medyaya ulaşmak için kullandığı adres. INTERNAL_API_URL ile AYNI
# gerekçeyle (`*.localhost` Node.js'te ÇÖZÜLEMEZ, §6.1) `siteadi.localhost` host şemasına
# geçişle birlikte bare-metal `npm run dev`'de de ZORUNLU hale geldi — artık BOŞ
# bırakılmamalı. Docker Compose'da `docker-compose.yml`'in `build.args` bloğunda
# `http://backend:4000` olarak OVERRIDE edilir. bkz. src/lib/env.ts::INTERNAL_MEDIA_ORIGIN.
# E2E'de port :4001'dir.
NEXT_PUBLIC_INTERNAL_MEDIA_URL=http://localhost:4000

# Backend'in on-demand revalidation webhook'unu (POST /api/revalidate, bkz.
# src/app/api/revalidate/route.ts) çağırırken gönderdiği `x-revalidate-secret` header'ı ile
# eşleşmesi gereken paylaşılan sır — backend↔frontend servis-servis kimlik doğrulaması,
# kullanıcı oturumu DEĞİLDİR. Boş/eksikse (veya eski örnek yer tutucu "change-me-in-production"
# ise) webhook her zaman 401 döner (fail-closed) ve açılışta uyarı loglanır. backend/.env'deki
# REVALIDATE_SECRET ile BİREBİR aynı olmalı. Üretmek için: openssl rand -hex 32
REVALIDATE_SECRET=

# Hata takibi (Sentry veya uyumlu bir self-hosted alternatif — örn. GlitchTip). Boş bırakılırsa
# Sentry HİÇ init edilmez (varsayılan KAPALI) — bkz. src/instrumentation-client.ts,
# src/sentry.server.config.ts, src/sentry.edge.config.ts. `NEXT_PUBLIC_` prefix'i OLMAYANLAR
# (SENTRY_DSN, SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN) yalnızca sunucu tarafında/
# build-time'da okunur, tarayıcıya asla gönderilmez.
# Tarayıcıda (client) çalışan hataları yakalamak için:
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Next.js sunucu tarafı (Server Component/Route Handler/Server Action) hataları için — genelde
# NEXT_PUBLIC_SENTRY_DSN ile AYNI DSN kullanılabilir (Sentry'de tek bir Next.js projesi
# hem client hem server event'lerini kabul eder), ama Sentry backend/ için ayrı bir proje
# öneriyorsa burada backend'in kendi DSN'i DEĞİL, bu frontend servisinin DSN'i olmalı.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Yalnızca CI/production build'lerinde source map yükleme (okunaklı stack trace) için — İSTEĞE
# BAĞLIDIR, boş bırakılırsa build sorunsuz çalışır, sadece Sentry'deki stack trace'ler minify
# edilmiş kalır. Sentry.io → Settings → Auth Tokens'tan alınır.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
